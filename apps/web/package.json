{
  "name": "@uapt/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @uapt/db generate && node ../../scripts/prepare-web-runtime-data.mjs && tsx --tsconfig tsconfig.json ../../scripts/validate-web-runtime-data.ts && next build",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@uapt/db": "workspace:*",
    "@uapt/shared": "workspace:*",
    "next": "^16.4.2",
    "next-intl": "^4.13.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
