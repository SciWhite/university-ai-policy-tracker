{"schemaVersion":"uapt-school-change-events-v2","revision":"qs91-100-v6-presentation-r1-20261026","slug":"university-of-murcia","basisSha256":"a1d6e1ee8ec909d02e8e5685f6b06229a71c4d2b4e951ab04ed5ce435bdb2565","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-murcia:public-release-20260526-003","slug":"university-of-murcia","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-24T14:32:00.000Z","url":"/changes/public-release-20260526-003/university-of-murcia","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-umu-library-ai-citation-guidance","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-umu-library-ai-citation-guidance","matchMethod":"none","newText":"The University of Murcia library AI page gives AI citation guidance, including describing AI use in methodology, including the prompt and relevant response fragment, citing reliable sources, and checking the citation style.","sourceUrls":["https://www.um.es/web/biblioteca/estudiar-investigar/ia-en-la-biblioteca"]},{"id":"claim:claim-umu-library-ai-class-tfg-tfm-approval","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-umu-library-ai-class-tfg-tfm-approval","matchMethod":"none","newText":"The University of Murcia library AI page advises that, for TFG/TFM work, instructors should tell students they need instructor confirmation before using AI tools.","sourceUrls":["https://www.um.es/web/biblioteca/estudiar-investigar/ia-en-la-biblioteca"]},{"id":"claim:claim-umu-library-ai-research-sensitive-activities","category":"tracker_addition","theme":"research","claimId":"claim-umu-library-ai-research-sensitive-activities","matchMethod":"none","newText":"The University of Murcia library AI page summarizes European research guidance saying researchers should abstain from using generative AI tools in sensitive activities such as peer review or evaluations, and should use generative AI respecting privacy, confidentiality, and intellectual property rights.","sourceUrls":["https://www.um.es/web/biblioteca/estudiar-investigar/ia-en-la-biblioteca"]},{"id":"claim:claim-umu-library-ai-responsible-use-privacy","category":"tracker_addition","theme":"privacy","claimId":"claim-umu-library-ai-responsible-use-privacy","matchMethod":"none","newText":"The University of Murcia library AI page frames responsible AI use as including privacy, intellectual property, ethics, and confidentiality considerations.","sourceUrls":["https://www.um.es/web/biblioteca/estudiar-investigar/ia-en-la-biblioteca"]},{"id":"claim:claim-umu-library-ai-tools-source-status","category":"tracker_addition","theme":"source_status","claimId":"claim-umu-library-ai-tools-source-status","matchMethod":"none","newText":"The official University of Murcia library AI page lists AI tools of interest to the university community by category, but the located source does not label the listed tools as university-approved or prohibited tools.","sourceUrls":["https://www.um.es/web/biblioteca/estudiar-investigar/ia-en-la-biblioteca"]},{"id":"source_added:https://www.um.es/web/biblioteca/estudiar-investigar/ia-en-la-biblioteca","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.um.es/web/biblioteca/estudiar-investigar/ia-en-la-biblioteca"]}],"counts":{"affected":5,"held":0,"added":5,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"8dc5eb6135d8a9986c376a355c153e7c65a96a33970afa4a5ab8805ec51b6338"}]}],"coverage":{"recordedFrom":"2026-05-24T14:32:00.000Z","gaps":[]}}
