{"schemaVersion":"uapt-school-change-events-v2","revision":"qs51-70-v6-presentation-20261025","slug":"yokohama-city-university","basisSha256":"e7482ef3dcdc2bce8168bb39c6d75dead3281e15583e798ffa4cf2d203e3d6bf","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"yokohama-city-university:public-release-20260612-001","slug":"yokohama-city-university","revision":"public-release-20260612-001","previousRevision":"public-release-20260526-003","publishedAt":"2026-05-31T20:45:00.000Z","url":"/changes/public-release-20260612-001/yokohama-city-university","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-ycu-ai-confidential-personal-data","category":"tracker_addition","theme":"privacy","claimId":"claim-ycu-ai-confidential-personal-data","matchMethod":"none","newText":"Yokohama City University tells students not to input personal information or confidential information learned through student life into generative AI because entered content may unintentionally leak.","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf"]},{"id":"claim:claim-ycu-ai-disclosure-citation","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ycu-ai-disclosure-citation","matchMethod":"none","newText":"Except for basic uses such as grammar and spelling checks, Yokohama City University tells students to disclose use of generative AI when using it as a tool in part of a submission, or cite it when quoting AI-generated text.","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf"]},{"id":"claim:claim-ycu-ai-output-verification","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ycu-ai-output-verification","matchMethod":"none","newText":"Yokohama City University tells students that information obtained from generative AI is not necessarily correct, and that submitted work should be critically examined through source checks, program verification, calculation checks, and similar review.","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf"]},{"id":"claim:claim-ycu-ai-use-not-generally-restricted","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-ycu-ai-use-not-generally-restricted","matchMethod":"none","newText":"Yokohama City University states that it does not itself restrict the use of generative AI in learning, while framing correct use as important.","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf"]},{"id":"claim:claim-ycu-course-level-ai-restrictions","category":"tracker_addition","theme":"teaching","claimId":"claim-ycu-course-level-ai-restrictions","matchMethod":"none","newText":"Yokohama City University notes that some classes may restrict or prohibit generative AI use, and tells students to follow instructions given in class or through YCU-Board.","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf"]},{"id":"claim:claim-ycu-student-authorship-responsibility","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ycu-student-authorship-responsibility","matchMethod":"none","newText":"Yokohama City University tells students that reaction papers, reports, essays, theses, and similar submissions are to be thought through and created by the students themselves, and that students bear authorial responsibility for submitted work.","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf"]},{"id":"source_added:https://www.yokohama-cu.ac.jp/students/edu/chatgpt.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/chatgpt.html"]},{"id":"source_added:https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.yokohama-cu.ac.jp/students/edu/dr3e6400000246d4-att/dr3e64000002470y.pdf"]}],"counts":{"affected":6,"held":0,"added":6,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"2ccaa528dd5e6c4d574c2f1db2c1b5f771026f32bd3f8db2e44142c2b2529971"}]}],"coverage":{"recordedFrom":"2026-05-31T20:45:00.000Z","gaps":[]}}