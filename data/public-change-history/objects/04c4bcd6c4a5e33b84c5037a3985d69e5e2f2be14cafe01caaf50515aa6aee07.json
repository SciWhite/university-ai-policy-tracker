{"schemaVersion":"uapt-school-change-events-v2","revision":"v6-qs101-120-presentation-20261028","slug":"universit-de-bretagne-occidentale","basisSha256":"86f34606cfb89445028c2a6b3f137815945958bd08b67006ac8bcd6a423bd44d","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"universit-de-bretagne-occidentale:public-release-20260612-001","slug":"universit-de-bretagne-occidentale","revision":"public-release-20260612-001","previousRevision":"public-release-20260526-003","publishedAt":"2026-05-31T20:50:50.000Z","url":"/changes/public-release-20260612-001/universit-de-bretagne-occidentale","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-ubo-ai-assessment-cheating","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ubo-ai-assessment-cheating","matchMethod":"none","newText":"UBO's generative AI charter says that, unless teaching staff communicate otherwise, student work for assessment should not be produced by generative AI tools in replacement of the expected reflective and intellectual process; otherwise it would constitute established cheating and could be sanctioned.","sourceUrls":["https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2026-03/Charte-IA-UBO_2026.pdf"]},{"id":"claim:claim-ubo-ai-charter-adopted-scope","category":"tracker_addition","theme":"source_status","claimId":"claim-ubo-ai-charter-adopted-scope","matchMethod":"none","newText":"UBO announced that its board adopted a generative AI charter on 12 March 2026 as a corollary to the digital resources charter, and the announcement says the two regulations engage the whole university community.","sourceUrls":["https://www.univ-brest.fr/fr/actualite/lubo-renouvelle-sa-charte-du-numerique-et-adopte-une-charte-dutilisation-de-lia"]},{"id":"claim:claim-ubo-ai-sensitive-confidential-data","category":"tracker_addition","theme":"privacy","claimId":"claim-ubo-ai-sensitive-confidential-data","matchMethod":"none","newText":"UBO's generative AI charter says generative AI must not be used to process sensitive data, and non-sovereign generative AI must not be used to process confidential data.","sourceUrls":["https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2026-03/Charte-IA-UBO_2026.pdf"]},{"id":"claim:claim-ubo-ai-sovereign-tools","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-ubo-ai-sovereign-tools","matchMethod":"none","newText":"UBO's generative AI charter says only institution-validated generative AI tools identified as sovereign may be freely used, while respecting the charter principles.","sourceUrls":["https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2026-03/Charte-IA-UBO_2026.pdf"]},{"id":"claim:claim-ubo-ai-use-disclosure","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ubo-ai-use-disclosure","matchMethod":"none","newText":"UBO's generative AI charter says that when generative AI has been used to produce or help produce academic or professional content, this use must be mentioned in the final document with the tool name/version, date, purpose, and level of human supervision or validation.","sourceUrls":["https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2026-03/Charte-IA-UBO_2026.pdf"]},{"id":"claim:claim-ubo-anti-plagiarism-ai-citation","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ubo-anti-plagiarism-ai-citation","matchMethod":"none","newText":"UBO's anti-plagiarism charter says students and staff commit to cite works they use or partially reproduce, including when they use an artificial intelligence program.","sourceUrls":["https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2025-08/charte_anti-plagiat-i20240625-apres_cfvu.pdf"]},{"id":"source_added:https://bu.univ-brest.fr/utiliser-ia/","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://bu.univ-brest.fr/utiliser-ia/"]},{"id":"source_added:https://www.univ-brest.fr/fr/actualite/lubo-renouvelle-sa-charte-du-numerique-et-adopte-une-charte-dutilisation-de-lia","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.univ-brest.fr/fr/actualite/lubo-renouvelle-sa-charte-du-numerique-et-adopte-une-charte-dutilisation-de-lia"]},{"id":"source_added:https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2025-08/charte_anti-plagiat-i20240625-apres_cfvu.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2025-08/charte_anti-plagiat-i20240625-apres_cfvu.pdf"]},{"id":"source_added:https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2026-03/Charte-IA-UBO_2026.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.univ-brest.fr/sites/nouveau.univ-brest.fr/files/2026-03/Charte-IA-UBO_2026.pdf"]}],"counts":{"affected":6,"held":0,"added":6,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"13a770567aea097c9723df1268cfc4c93c42ba6152dee78ab69c9c5731ba79a7"}]}],"coverage":{"recordedFrom":"2026-05-31T20:50:50.000Z","gaps":[]}}