","sha256":"92839bc9cc6b0e69aa8b8498cba16efde5daf90898eea8e45acd3476ce41c15a"}]},{"id":"university-of-arkansas-fayetteville:public-release-20260526-003","slug":"university-of-arkansas-fayetteville","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T04:19:18.000Z","url":"/changes/public-release-20260526-003/university-of-arkansas-fayetteville","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-uark-ai-citation","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uark-ai-citation","matchMethod":"none","newText":"The University of Arkansas Libraries AI and Academic Integrity guide says students are expected to cite anything that is not their original work, including text generated by artificial intelligence.","sourceUrls":["https://libguides.uark.edu/c.php?g=1336583&p=9847560"]},{"id":"claim:claim-uark-ai-guidelines-adherence","category":"tracker_addition","theme":"source_status","claimId":"claim-uark-ai-guidelines-adherence","matchMethod":"none","newText":"A January 2026 University of Arkansas campus advisory says employees and students must adhere to the university's acceptable-use guidelines for artificial intelligence, covering ethical and responsible use, teaching and learning, research, and allowable AI tools.","sourceUrls":["https://news.uark.edu/articles/80623/more-ai-tools-and-resources-approved-and-available-for-campus"]},{"id":"claim:claim-uark-approved-ai-tools","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-uark-approved-ai-tools","matchMethod":"none","newText":"A January 2026 University of Arkansas advisory lists Copilot Chat, Copilot for Microsoft 365, OpenAI ChatGPT Edu, Google Gemini, and Google NotebookLM as approved AI tools available for campus use, with some tools requiring licenses.","sourceUrls":["https://news.uark.edu/articles/80623/more-ai-tools-and-resources-approved-and-available-for-campus"]},{"id":"claim:claim-uark-faculty-ai-syllabus-options","category":"tracker_addition","theme":"teaching","claimId":"claim-uark-faculty-ai-syllabus-options","matchMethod":"none","newText":"The University of Arkansas Academic Initiatives and Integrity faculty resources page says faculty have discretion over student use of generative AI in their courses and provides approved syllabus statement options for prohibited, restricted, and unrestricted use.","sourceUrls":["https://honesty.uark.edu/faculty/remote-teaching.php"]},{"id":"claim:claim-uark-student-ai-permission","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uark-student-ai-permission","matchMethod":"none","newText":"The University of Arkansas Libraries AI and Academic Integrity guide says students must receive instructor permission in advance before using generative AI technology to complete academic work.","sourceUrls":["https://libguides.uark.edu/c.php?g=1336583&p=9847560"]},{"id":"claim:claim-uark-unapproved-tool-exception","category":"tracker_addition","theme":"security_review","claimId":"claim-uark-unapproved-tool-exception","matchMethod":"none","newText":"The University of Arkansas advisory says employees or students who want to use an AI tool that is not approved need to complete a tool exception request form.","sourceUrls":["https://news.uark.edu/articles/80623/more-ai-tools-and-resources-approved-and-available-for-campus"]},{"id":"source_added:https://honesty.uark.edu/faculty/remote-teaching.php","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://honesty.uark.edu/faculty/remote-teaching.php"]},{"id":"source_added:https://libguides.uark.edu/c.php?g=1336583&p=9847560","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://libguides.uark.edu/c.php?g=1336583&p=9847560"]},{"id":"source_added:https://news.uark.edu/articles/80623/more-ai-tools-and-resources-approved-and-available-for-campus","category":"sour