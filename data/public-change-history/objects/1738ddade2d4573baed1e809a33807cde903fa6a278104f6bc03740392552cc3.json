{"schemaVersion":"uapt-school-change-events-v2","revision":"qs51-70-v6-presentation-20261025","slug":"university-of-new-hampshire","basisSha256":"e7482ef3dcdc2bce8168bb39c6d75dead3281e15583e798ffa4cf2d203e3d6bf","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-new-hampshire:public-release-20260924-002","slug":"university-of-new-hampshire","revision":"public-release-20260924-002","previousRevision":"public-release-20260921-001","publishedAt":"2026-09-24T21:40:00.000Z","url":"/changes/public-release-20260924-002/university-of-new-hampshire","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:cl-usnh-approved-ai-tier3-autonomous-agents-20260924","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"cl-usnh-approved-ai-tier3-autonomous-agents-20260924","matchMethod":"none","newText":"USNH designates Microsoft Copilot Chat with Enterprise Data Protection (EDP) and DeepThought as approved generative AI platforms permitted for institutional data up to Tier III when authenticated with USNH credentials, and designates DeepThought for technical workflows including coding, development integration, and autonomous agents.","sourceUrls":["https://td.usnh.edu/TDClient/60/Portal/KB/ArticleDet?ID=5322"]},{"id":"source_snapshot_changed:https://td.usnh.edu/TDClient/60/Portal/KB/ArticleDet?ID=5322","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://td.usnh.edu/TDClient/60/Portal/KB/ArticleDet?ID=5322"]}],"counts":{"affected":1,"held":0,"added":1,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"69e441268a2183024a5dbe21d908fd07ac9137443ee85dd86bee305475bbb4a1"}]},{"id":"university-of-new-hampshire:public-release-20260526-003","slug":"university-of-new-hampshire","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-25T06:26:27.000Z","url":"/changes/public-release-20260526-003/university-of-new-hampshire","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:unh-ai-course-disclosure-20260525","category":"tracker_addition","theme":"teaching","claimId":"unh-ai-course-disclosure-20260525","matchMethod":"none","newText":"UNH Provost syllabus guidance recommends that instructors explicitly tell students whether automated writing tools and AI tools are allowed in a course, and if allowed, specify how and when they may be used.","sourceUrls":["https://www.unh.edu/provost/sites/default/files/media/2025-08/syllabus-guidance-Fall%202025%20FINAL.docx"]},{"id":"claim:unh-ai-ferpa-detection-evaluation-20260525","category":"tracker_addition","theme":"privacy","claimId":"unh-ai-ferpa-detection-evaluation-20260525","matchMethod":"none","newText":"UNH Provost syllabus guidance says generative-AI detection tools should not be used to make definitive academic-integrity judgments, and says uploading documents containing student names, emails, or ID numbers violates FERPA; faculty using AI-enabled tools to evaluate student work must disclose that use and keep student data protections in mind.","sourceUrls":["https://www.unh.edu/provost/sites/default/files/media/2025-08/syllabus-guidance-Fall%202025%20FINAL.docx"]},{"id":"claim:unh-ai-source-status-teaching-resources-20260525","category":"tracker_addition","theme":"source_status","claimId":"unh-ai-source-status-teaching-resources-20260525","matchMethod":"none","newText":"UNH maintains official Teaching & Learning Resource Hub pages for generative AI and academic honesty that point faculty to AI programming, UNH AI-related policies, the Provost syllabus guidance, and an Academic Honesty and AI policy summary; these pages were used as source-status context rather than binding policy by themselves.","sourceUrls":["https://www.unh.edu/teaching-learning-resource-hub/delivery/generative-artificial-intelligence"]},{"id":"claim:unh-ai-unauthorized-use-integrity-20260525","category":"tracker_addition","theme":"academic_integrity","claimId":"unh-ai-unauthorized-use-integrity-20260525","matchMethod":"none","newText":"UNH's Academic Integrity policy treats unauthorized use or attempted use of AI tools as cheating, and treats computer-generated text or work submitted as one's own without proper citation or attribution as plagiarism.","sourceUrls":["https://catalog.unh.edu/srrr/student-policies-regulations/academic-integrity/"]},{"id":"claim:usnh-ai-chatbot-secure-tooling-20260525","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"usnh-ai-chatbot-secure-tooling-20260525","matchMethod":"none","newText":"USNH's AI chatbot KB identifies DeepThought and Microsoft Copilot as USNH-provided AI options, recommends signing into Copilot with a USNH account for enterprise data protection, says public chatbots such as ChatGPT and Bard are not secure, and says alternative AI solutions must complete the Security Assessment Review process before purchase or implementation.","sourceUrls":["https://td.usnh.edu/TDClient/60/Portal/KB/ArticleDet?ID=5322"]},{"id":"claim:usnh-ai-nonpublic-data-standard-20260525","category":"tracker_addition","theme":"security_review","claimId":"usnh-ai-nonpublic-data-standard-20260525","matchMethod":"none","newText":"The USNH Artificial Intelligence Standard, which applies to USNH component institutions, says users of AI tools must not share or enter non-public Tier 2 or higher data, including PII or non-public research data, and that any AI implementation is subject to USNH policies, standards, and security review.","sourceUrls":["https://www.usnh.edu/it/departments/cybersecurity/cybersecurity-policies-standards/artificial-intelligence-standard"]},{"id":"source_added:https://catalog.unh.edu/srrr/student-policies-regulations/academic-integrity/","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://catalog.unh.edu/srrr/student-policies-regulations/academic-integrity/"]},{"id":"source_added:https://td.usnh.edu/TDClient/60/Portal/KB/ArticleDet?ID=5322","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://td.usnh.edu/TDClient/60/Portal/KB/ArticleDet?ID=5322"]},{"id":"source_added:https://www.unh.edu/provost/sites/default/files/media/2025-08/syllabus-guidance-Fall%202025%20FINAL.docx","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unh.edu/provost/sites/default/files/media/2025-08/syllabus-guidance-Fall%202025%20FINAL.docx"]},{"id":"source_added:https://www.unh.edu/teaching-learning-resource-hub/assessment/academic-honesty","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unh.edu/teaching-learning-resource-hub/assessment/academic-honesty"]},{"id":"source_added:https://www.unh.edu/teaching-learning-resource-hub/delivery/generative-artificial-intelligence","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unh.edu/teaching-learning-resource-hub/delivery/generative-artificial-intelligence"]},{"id":"source_added:https://www.usnh.edu/it/departments/cybersecurity/cybersecurity-policies-standards/artificial-intelligence-standard","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.usnh.edu/it/departments/cybersecurity/cybersecurity-policies-standards/artificial-intelligence-standard"]}],"counts":{"affected":6,"held":0,"added":6,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"3e3e606c3dcb2c4705f4659057661dfb0df12049b306b76f7508e86fa960700e"}]}],"coverage":{"recordedFrom":"2026-05-25T06:26:27.000Z","gaps":[]}}