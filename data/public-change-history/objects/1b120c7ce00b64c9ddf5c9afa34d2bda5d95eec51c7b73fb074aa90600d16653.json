{"schemaVersion":"uapt-school-change-events-v2","revision":"qs71-90-v6-completeness-r2-20261025","slug":"university-of-the-free-state","basisSha256":"fc7362bea155368de66e06f9e4b0b27316d00188159ee747fdd876799c8aa259","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-the-free-state:public-release-20260526-003","slug":"university-of-the-free-state","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-26T05:14:00.000Z","url":"/changes/public-release-20260526-003/university-of-the-free-state","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-ufs-ai-detection-discontinued-2026","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ufs-ai-detection-discontinued-2026","matchMethod":"none","newText":"UFS announced that it will discontinue the use of AI detection software across all faculties and academic activities from 1 July 2026.","sourceUrls":["https://www.ufs.ac.za/templates/news-archive/campus-news/2026/may/ufs-shifts-academic-integrity-approach-in-ai-era"]},{"id":"claim:claim-ufs-ai-integrity-principle-2025","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ufs-ai-integrity-principle-2025","matchMethod":"none","newText":"UFS identifies academic rigour, integrity, and honesty as a guiding principle for AI use and says AI integration should not undermine academic integrity, ethics, and honesty.","sourceUrls":["https://www.ufs.ac.za/docs/default-source/2026-web-documents/ufs-ai-position-statement_2025.pdf?sfvrsn=630ff820_1"]},{"id":"claim:claim-ufs-ai-literacy-support-2025","category":"tracker_addition","theme":"teaching","claimId":"claim-ufs-ai-literacy-support-2025","matchMethod":"none","newText":"UFS says AI literacy and skills should be developed as part of digital competencies across all levels of the institution, with students, staff, and stakeholders supported to use AI tools effectively and responsibly.","sourceUrls":["https://www.ufs.ac.za/docs/default-source/2026-web-documents/ufs-ai-position-statement_2025.pdf?sfvrsn=630ff820_1"]},{"id":"claim:claim-ufs-ai-position-scope-2025","category":"tracker_addition","theme":"source_status","claimId":"claim-ufs-ai-position-scope-2025","matchMethod":"none","newText":"The University of the Free State has a Senate-approved AI Position Statement that covers both generative and assistive AI technologies across teaching and learning, research, and administrative tasks.","sourceUrls":["https://www.ufs.ac.za/docs/default-source/2026-web-documents/ufs-ai-position-statement_2025.pdf?sfvrsn=630ff820_1"]},{"id":"claim:claim-ufs-ai-privacy-security-principle-2025","category":"tracker_addition","theme":"privacy","claimId":"claim-ufs-ai-privacy-security-principle-2025","matchMethod":"none","newText":"UFS lists respect and awareness as an AI guiding principle, including respect for individuals' privacy and data security and awareness of potential social and environmental harm.","sourceUrls":["https://www.ufs.ac.za/docs/default-source/2026-web-documents/ufs-ai-position-statement_2025.pdf?sfvrsn=630ff820_1"]},{"id":"claim:claim-ufs-no-blanket-ai-restriction-2025","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-ufs-no-blanket-ai-restriction-2025","matchMethod":"none","newText":"UFS states that it does not impose a blanket restriction on AI use, while noting that advantages, disadvantages, and implications need to be considered in different UFS spheres.","sourceUrls":["https://www.ufs.ac.za/docs/default-source/2026-web-documents/ufs-ai-position-statement_2025.pdf?sfvrsn=630ff820_1"]},{"id":"claim:claim-ufs-student-ai-responsibility-2026","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ufs-student-ai-responsibility-2026","matchMethod":"none","newText":"UFS reaffirmed that students remain responsible for producing original work and using generative AI tools honestly and appropriately within institutional guidelines.","sourceUrls":["https://www.ufs.ac.za/templates/news-archive/campus-news/2026/may/ufs-shifts-academic-integrity-approach-in-ai-era"]},{"id":"source_added:https://www.ufs.ac.za/docs/default-source/2026-web-documents/ufs-ai-position-statement_2025.pdf?sfvrsn=630ff820_1","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.ufs.ac.za/docs/default-source/2026-web-documents/ufs-ai-position-statement_2025.pdf?sfvrsn=630ff820_1"]},{"id":"source_added:https://www.ufs.ac.za/templates/news-archive/campus-news/2026/may/ufs-shifts-academic-integrity-approach-in-ai-era","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.ufs.ac.za/templates/news-archive/campus-news/2026/may/ufs-shifts-academic-integrity-approach-in-ai-era"]}],"counts":{"affected":7,"held":0,"added":7,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"0fd908a785d5c1575afa7a7cab84ee565ade05797339608a5785094ad94f3152"}]}],"coverage":{"recordedFrom":"2026-05-26T05:14:00.000Z","gaps":[]}}
