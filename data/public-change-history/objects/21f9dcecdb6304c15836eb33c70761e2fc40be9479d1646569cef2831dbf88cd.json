{"schemaVersion":"uapt-school-change-events-v2","revision":"qs46-50-v6-r1-20261023","slug":"universita-degli-studi-di-udine","basisSha256":"c96faf43f849ffa68ba03ef83e7138f23c153dbd5ed26c33bd47a6689a154b6f","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"universita-degli-studi-di-udine:public-release-20260526-003","slug":"universita-degli-studi-di-udine","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-26T05:09:08.000Z","url":"/changes/public-release-20260526-003/universita-degli-studi-di-udine","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:cl-uniud-biotecnologie-ai-allowed-uses","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"cl-uniud-biotecnologie-ai-allowed-uses","matchMethod":"none","newText":"For the University of Udine Biotechnology bachelor's thesis guideline, generative AI tools are described as usable for limited support such as grammar/spelling correction, technical-term translation, and orienting summaries, not as a substitute for the student's own thesis work.","sourceUrls":["https://www.uniud.it/it/didattica/corsi/area-scientifica/biotecnologie/laurea/biotecnologie/laurearsi/linee-guida-tirocinio-pre-laurea/linee-guida-stesura-relazione-tirocinio-pre-laurea-biotecnologie.pdf/download"]},{"id":"claim:cl-uniud-biotecnologie-ai-declaration","category":"tracker_addition","theme":"academic_integrity","claimId":"cl-uniud-biotecnologie-ai-declaration","matchMethod":"none","newText":"The Biotechnology bachelor's thesis guideline says that if a student used AI tools at any stage of thesis writing, the student is required to explicitly declare the tool, version if available, date, and nature of use in a methodological note.","sourceUrls":["https://www.uniud.it/it/didattica/corsi/area-scientifica/biotecnologie/laurea/biotecnologie/laurearsi/linee-guida-tirocinio-pre-laurea/linee-guida-stesura-relazione-tirocinio-pre-laurea-biotecnologie.pdf/download"]},{"id":"claim:cl-uniud-biotecnologie-ai-plagiarism-consequence","category":"tracker_addition","theme":"academic_integrity","claimId":"cl-uniud-biotecnologie-ai-plagiarism-consequence","matchMethod":"none","newText":"The Biotechnology bachelor's thesis guideline says non-compliance with its AI-use indications is treated as comparable to plagiarism and may lead to disciplinary sanctions under the university regulation.","sourceUrls":["https://www.uniud.it/it/didattica/corsi/area-scientifica/biotecnologie/laurea/biotecnologie/laurearsi/linee-guida-tirocinio-pre-laurea/linee-guida-stesura-relazione-tirocinio-pre-laurea-biotecnologie.pdf/download"]},{"id":"claim:cl-uniud-biotecnologie-ai-prohibited-uses","category":"tracker_addition","theme":"academic_integrity","claimId":"cl-uniud-biotecnologie-ai-prohibited-uses","matchMethod":"none","newText":"The Biotechnology bachelor's thesis guideline says students should not insert automatically generated scientific text into the thesis, replace bibliographic research with AI, or use AI-generated text without critical and personal reworking.","sourceUrls":["https://www.uniud.it/it/didattica/corsi/area-scientifica/biotecnologie/laurea/biotecnologie/laurearsi/linee-guida-tirocinio-pre-laurea/linee-guida-stesura-relazione-tirocinio-pre-laurea-biotecnologie.pdf/download"]},{"id":"claim:cl-uniud-piao-ai-training-source-status","category":"tracker_addition","theme":"source_status","claimId":"cl-uniud-piao-ai-training-source-status","matchMethod":"none","newText":"The University of Udine PIAO 2026-2028 provides official source-status evidence that the university planned staff training and process integration around AI, including responsible generative AI in administrative processes, but this source is not a student AI-use policy.","sourceUrls":["https://www.uniud.it/it/ateneo-uniud/ateneo-uniud/amministrazione-trasparente/disposizioni-generali/atti-generali/piao-2026-d.pdf/@@download/file/PIAO%202026%20D.pdf"]},{"id":"source_added:https://www.uniud.it/it/ateneo-uniud/ateneo-uniud/amministrazione-trasparente/disposizioni-generali/atti-generali/piao-2026-d.pdf/@@download/file/PIAO%202026%20D.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.uniud.it/it/ateneo-uniud/ateneo-uniud/amministrazione-trasparente/disposizioni-generali/atti-generali/piao-2026-d.pdf/@@download/file/PIAO%202026%20D.pdf"]},{"id":"source_added:https://www.uniud.it/it/didattica/corsi/area-scientifica/biotecnologie/laurea/biotecnologie/laurearsi/linee-guida-tirocinio-pre-laurea/linee-guida-stesura-relazione-tirocinio-pre-laurea-biotecnologie.pdf/download","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.uniud.it/it/didattica/corsi/area-scientifica/biotecnologie/laurea/biotecnologie/laurearsi/linee-guida-tirocinio-pre-laurea/linee-guida-stesura-relazione-tirocinio-pre-laurea-biotecnologie.pdf/download"]}],"counts":{"affected":5,"held":0,"added":5,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"6848ca8afcec8b8e4d0a78f033376693dd1eb7439b31a6f729f8ccb5b6bb577b"}]}],"coverage":{"recordedFrom":"2026-05-26T05:09:08.000Z","gaps":[]}}