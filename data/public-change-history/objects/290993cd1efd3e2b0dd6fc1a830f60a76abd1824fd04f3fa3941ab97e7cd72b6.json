{"schemaVersion":"uapt-school-change-events-v2","revision":"v6-reading-rankings-ten-20261027","slug":"university-of-colombo","basisSha256":"40caf4e7e27cfa6241f8558d0f86f87f839ec25d4ed545c5f9a48c8319a09e80","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-colombo:public-release-20260526-003","slug":"university-of-colombo","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T14:48:20.000Z","url":"/changes/public-release-20260526-003/university-of-colombo","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-uoc-accountability-verification","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uoc-accountability-verification","matchMethod":"none","newText":"University of Colombo requires students and staff to remain responsible for work involving AI and to review, fact-check, and edit AI-generated content before using it in academic or administrative work.","sourceUrls":["https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf"]},{"id":"claim:claim-uoc-ai-privacy-confidentiality","category":"tracker_addition","theme":"privacy","claimId":"claim-uoc-ai-privacy-confidentiality","matchMethod":"none","newText":"University of Colombo prohibits students and staff from uploading or sharing sensitive, confidential, or personally identifiable information into AI tools or online platforms.","sourceUrls":["https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf"]},{"id":"claim:claim-uoc-genai-policy-scope","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-uoc-genai-policy-scope","matchMethod":"none","newText":"University of Colombo states that its generative AI policy applies to the use of GenAI tools in academic and administrative activities.","sourceUrls":["https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf"]},{"id":"claim:claim-uoc-student-ai-acknowledgement","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uoc-student-ai-acknowledgement","matchMethod":"none","newText":"For student work, University of Colombo says AI uses beyond citation/reference generation and accessibility support must be explicitly acknowledged, and that the original intellectual work, analysis, interpretation, and synthesis must be the student's own.","sourceUrls":["https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf"]},{"id":"claim:claim-uoc-teaching-assessment-human-led","category":"tracker_addition","theme":"teaching","claimId":"claim-uoc-teaching-assessment-human-led","matchMethod":"none","newText":"For teaching, University of Colombo says AI tools must not be used to mark or grade student work, generate evaluative feedback, or contribute to summative assessment decisions unless institutional review, validation, quality assurance, and meaningful human oversight are in place.","sourceUrls":["https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf"]},{"id":"claim:claim-uoc-unauthorized-assessment-ai","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uoc-unauthorized-assessment-ai","matchMethod":"none","newText":"University of Colombo says AI use in assessments is not permitted unless instructions explicitly authorize it, and unauthorized AI use in summative assessment is considered cheating and an examination offence.","sourceUrls":["https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf"]},{"id":"source_added:https://cmb.ac.lk/cqa/policies-procedures","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://cmb.ac.lk/cqa/policies-procedures"]},{"id":"source_added:https://science.cmb.ac.lk/for-current-postgraduates/","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://science.cmb.ac.lk/for-current-postgraduates/"]},{"id":"source_added:https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://science.cmb.ac.lk/wp-content/uploads/2026/05/AI-Policy-1-1.pdf"]}],"counts":{"affected":6,"held":0,"added":6,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"e1aebd69ee8c1c06e0ac949ad313747ab73c4798ee53fb40f5d143d7d3ae190d"}]}],"coverage":{"recordedFrom":"2026-05-23T14:48:20.000Z","gaps":[]}}