{"schemaVersion":"uapt-school-change-events-v2","revision":"qs71-90-v6-completeness-r2-20261025","slug":"university-of-louisville","basisSha256":"fc7362bea155368de66e06f9e4b0b27316d00188159ee747fdd876799c8aa259","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-louisville:public-release-20260719-012","slug":"university-of-louisville","revision":"public-release-20260719-012","previousRevision":"public-release-20260719-011","publishedAt":"2026-07-19T15:21:39.689Z","url":"/changes/public-release-20260719-012/university-of-louisville","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:cl-university-of-louisville-microsoft-copilot-for-m365-1087","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"cl-university-of-louisville-microsoft-copilot-for-m365-1087","matchMethod":"none","newText":"Microsoft 365 Copilot is listed for University of Louisville in an official university AI tools source. Derived availability: allowed. Derived endorsement type: institutionally licensed or procured.","sourceUrls":["https://service.louisville.edu/TDClient/277/Portal/KB/Article/20086/AI-GenAI-Tools-How-to-Access-and-Use-GenAI-Tools-at-UofL"]},{"id":"source_added:https://service.louisville.edu/TDClient/277/Portal/KB/Article/20086/AI-GenAI-Tools-How-to-Access-and-Use-GenAI-Tools-at-UofL","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://service.louisville.edu/TDClient/277/Portal/KB/Article/20086/AI-GenAI-Tools-How-to-Access-and-Use-GenAI-Tools-at-UofL"]}],"counts":{"affected":1,"held":0,"added":1,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"cb71e765ff37da5151e3cfd7dfa1eaa060e0cddc4bd62a604872ec48e3ebecd3"}]},{"id":"university-of-louisville:public-release-20260526-003","slug":"university-of-louisville","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-24T14:27:29.000Z","url":"/changes/public-release-20260526-003/university-of-louisville","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-uofl-ai-detection-academic-integrity-20260524","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uofl-ai-detection-academic-integrity-20260524","matchMethod":"none","newText":"The University of Louisville Delphi Center says current AI detection tools are unreliable, raise data privacy, FERPA, and student-consent risks, and should never be the sole basis for an academic integrity decision.","sourceUrls":["https://delphi.louisville.edu/teaching-resources/generative-ai"]},{"id":"claim:claim-uofl-ai-syllabus-sample-statements-20260524","category":"tracker_addition","theme":"teaching","claimId":"claim-uofl-ai-syllabus-sample-statements-20260524","matchMethod":"none","newText":"The University of Louisville Delphi Center provides sample syllabus statements for three generative AI approaches: not permitted, permitted with prior instructor permission and appropriate attribution and citation, or allowed without restrictions.","sourceUrls":["https://delphi.louisville.edu/teaching-resources/syllabus-guidelines/sample-statements"]},{"id":"claim:claim-uofl-ai-tools-access-service-status-20260524","category":"tracker_addition","theme":"source_status","claimId":"claim-uofl-ai-tools-access-service-status-20260524","matchMethod":"none","newText":"The UofL service catalog describes an AI / GenAI Tools access request service, but marks it as coming soon and not currently available; the described process would limit access to approved university platforms and use cases and require intended use, data sensitivity, and compliance considerations.","sourceUrls":["https://service.louisville.edu/TDClient/277/Portal/Requests/ServiceDet?ID=10732"]},{"id":"claim:claim-uofl-assessment-design-ai-20260524","category":"tracker_addition","theme":"teaching","claimId":"claim-uofl-assessment-design-ai-20260524","matchMethod":"none","newText":"The University of Louisville Delphi Center frames generative and agentic AI as a teaching and assessment-design issue, advising instructors to design assessments so authentic engagement is more valuable than AI substitution rather than focusing on policing student behavior.","sourceUrls":["https://delphi.louisville.edu/teaching-resources/generative-ai"]},{"id":"claim:claim-uofl-brand-ai-policy-draft-status-20260524","category":"tracker_addition","theme":"source_status","claimId":"claim-uofl-brand-ai-policy-draft-status-20260524","matchMethod":"none","newText":"UofL's Brand Identity site publishes an Artificial Intelligence Content Policy page for university brand communications, but the page explicitly states that it is a draft policy awaiting approval by the University of Louisville administration.","sourceUrls":["https://brand.louisville.edu/policy/ai-content-policy"]},{"id":"claim:claim-uofl-its-ai-privacy-security-20260524","category":"tracker_addition","theme":"privacy","claimId":"claim-uofl-its-ai-privacy-security-20260524","matchMethod":"none","newText":"UofL ITS AI guidance states that federal privacy regulations and the NIST AI Risk Management Framework should be followed, and that users are individually responsible for misuse of systems and data mishandling involving student data, intellectual property, and protected personal information.","sourceUrls":["https://louisville.edu/its/ai-culture"]},{"id":"source_added:https://brand.louisville.edu/policy/ai-content-policy","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://brand.louisville.edu/policy/ai-content-policy"]},{"id":"source_added:https://delphi.louisville.edu/teaching-resources/generative-ai","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://delphi.louisville.edu/teaching-resources/generative-ai"]},{"id":"source_added:https://delphi.louisville.edu/teaching-resources/syllabus-guidelines/sample-statements","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://delphi.louisville.edu/teaching-resources/syllabus-guidelines/sample-statements"]},{"id":"source_added:https://louisville.edu/its/ai-culture","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://louisville.edu/its/ai-culture"]},{"id":"source_added:https://service.louisville.edu/TDClient/277/Portal/Requests/ServiceDet?ID=10732","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://service.louisville.edu/TDClient/277/Portal/Requests/ServiceDet?ID=10732"]}],"counts":{"affected":6,"held":0,"added":6,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"d2f3c36b8b346a038a3526a529a36cac61f12b2c5a8bd0cc852b07c4030f9005"}]}],"coverage":{"recordedFrom":"2026-05-24T14:27:29.000Z","gaps":[]}}
