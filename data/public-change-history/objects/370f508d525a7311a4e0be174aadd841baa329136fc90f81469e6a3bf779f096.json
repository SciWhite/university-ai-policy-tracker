{"schemaVersion":"uapt-school-change-events-v2","revision":"qs46-50-v6-r1-20261023","slug":"durham-university","basisSha256":"c96faf43f849ffa68ba03ef83e7138f23c153dbd5ed26c33bd47a6689a154b6f","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"durham-university:public-release-20260709-001","slug":"durham-university","revision":"public-release-20260709-001","previousRevision":"public-release-20260707-001","publishedAt":"2026-07-07T13:18:52.000Z","url":"/changes/public-release-20260709-001/durham-university","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-du-genai-assessment-categories","category":"tracker_addition","theme":"teaching","claimId":"claim-du-genai-assessment-categories","matchMethod":"none","newText":"Durham University categorises student assessments into four GenAI-use tiers: No GenAI Allowed, Selective (specified how GenAI may be used), Allowed (students may choose whether and how to use GenAI), and Embedded (using GenAI is required).","sourceUrls":["https://dcad-resourcebank.webspace.durham.ac.uk/2024/07/16/generative-ai-in-learning-teaching-assessment/"]},{"id":"claim:claim-du-genai-pg-research-policy-approved","category":"tracker_addition","theme":"research","claimId":"claim-du-genai-pg-research-policy-approved","matchMethod":"none","newText":"Senate approved a specific policy for the use of GenAI in postgraduate research degrees alongside the main GenAI policy in June 2026.","sourceUrls":["https://dcad-resourcebank.webspace.durham.ac.uk/2024/07/16/generative-ai-in-learning-teaching-assessment/"]},{"id":"claim:claim-du-genai-policy-senate-approved-june2026","category":"tracker_addition","theme":"source_status","claimId":"claim-du-genai-policy-senate-approved-june2026","matchMethod":"none","newText":"Durham University's GenAI policy for learning, teaching and assessment was approved by Senate in June 2026.","sourceUrls":["https://dcad-resourcebank.webspace.durham.ac.uk/2024/07/16/generative-ai-