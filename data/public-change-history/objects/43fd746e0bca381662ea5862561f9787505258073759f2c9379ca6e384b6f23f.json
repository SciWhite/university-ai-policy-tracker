{"schemaVersion":"uapt-school-change-events-v2","revision":"qs71-90-v6-reviewed-r1-20261025","slug":"university-of-toledo","basisSha256":"831ef681acccfa38466e5412c76abb89c77d7b90bf0151e5a6ac78ad4f696088","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-toledo:public-release-20260526-003","slug":"university-of-toledo","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-25T06:27:21.000Z","url":"/changes/public-release-20260526-003/university-of-toledo","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-utoledo-academic-dishonesty-ai-programs-20260525","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-utoledo-academic-dishonesty-ai-programs-20260525","matchMethod":"none","newText":"UToledo's Academic dishonesty policy lists representing the words, ideas, or information of an artificial intelligence program as one's own without proper documentation as an example of academic dishonesty, and says faculty are expected to tell students what materials and procedures, including artificial intelligence programs, are authorized.","sourceUrls":["https://www.utoledo.edu/policies/academic/undergraduate/pdfs/3364-71-04%20Academic%20dishonesty.pdf"]},{"id":"claim:claim-utoledo-ai-policy-source-status-20260525","category":"tracker_addition","theme":"source_status","claimId":"claim-utoledo-ai-policy-source-status-20260525","matchMethod":"none","newText":"The University of Toledo maintains a central Office of the Provost AI Policies page that points instructors to optional syllabus language for AI and links to a College of Law generative AI policy.","sourceUrls":["https://www.utoledo.edu/offices/provost/artificial-intelligence/ai-policies.html"]},{"id":"claim:claim-utoledo-law-generative-ai-default-rule-20260525","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-utoledo-law-generative-ai-default-rule-20260525","matchMethod":"none","newText":"The University of Toledo College of Law generative AI policy adopts a default rule that permits some uses of generative AI but bans uses that would be plagiaristic if the output had been composed by a human author.","sourceUrls":["https://www.utoledo.edu/law/studentlife/resources/generative-ai-policy.html"]},{"id":"claim:claim-utoledo-law-generative-ai-exam-assignment-limits-20260525","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-utoledo-law-generative-ai-exam-assignment-limits-20260525","matchMethod":"none","newText":"Within the University of Toledo College of Law default rule, generative AI may be used for research-like search, grammar correction, and other functions attendant to completing an assignment, but may not compose submitted assignment text and may not be used for any exam purpose unless an instructor deviates in writing with notice.","sourceUrls":["https://www.utoledo.edu/law/studentlife/resources/generative-ai-policy.html"]},{"id":"claim:claim-utoledo-simple-syllabus-ai-tool-usage-20260525","category":"tracker_addition","theme":"teaching","claimId":"claim-utoledo-simple-syllabus-ai-tool-usage-20260525","matchMethod":"none","newText":"UToledo's Simple Syllabus guidance says the AI Tool Usage section is required and private, and instructors must select or enter a statement explaining how generative AI tools may be used, limited, or prohibited in the course.","sourceUrls":["https://www.utoledo.edu/offices/provost/utc/syllabus/assignments-ai-tool-usage.html"]},{"id":"source_added:https://www.utoledo.edu/law/studentlife/resources/generative-ai-policy.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.utoledo.edu/law/studentlife/resources/generative-ai-policy.html"]},{"id":"source_added:https://www.utoledo.edu/offices/provost/artificial-intelligence/ai-policies.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.utoledo.edu/offices/provost/artificial-intelligence/ai-policies.html"]},{"id":"source_added:https://www.utoledo.edu/offices/provost/utc/syllabus/assignments-ai-tool-usage.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.utoledo.edu/offices/provost/utc/syllabus/assignments-ai-tool-usage.html"]},{"id":"source_added:https://www.utoledo.edu/policies/academic/undergraduate/pdfs/3364-71-04%20Academic%20dishonesty.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.utoledo.edu/policies/academic/undergraduate/pdfs/3364-71-04%20Academic%20dishonesty.pdf"]}],"counts":{"affected":5,"held":0,"added":5,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"b54502fc69c492f54dfd830c306dc392fac41c6cf758c07a147400d75ea3edef"}]}],"coverage":{"recordedFrom":"2026-05-25T06:27:21.000Z","gaps":[]}}
