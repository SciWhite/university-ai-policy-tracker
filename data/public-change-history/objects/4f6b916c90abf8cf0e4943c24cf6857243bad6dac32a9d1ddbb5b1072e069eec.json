{"schemaVersion":"uapt-school-change-events-v2","revision":"qs51-70-v6-presentation-20261025","slug":"indian-institute-of-technology-delhi","basisSha256":"e7482ef3dcdc2bce8168bb39c6d75dead3281e15583e798ffa4cf2d203e3d6bf","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"indian-institute-of-technology-delhi:public-release-20260727-015","slug":"indian-institute-of-technology-delhi","revision":"public-release-20260727-015","previousRevision":"public-release-20260727-014","publishedAt":"2026-07-27T05:20:00.000Z","url":"/changes/public-release-20260727-015/indian-institute-of-technology-delhi","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-iitd-genai-01-20260727","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-iitd-genai-01-20260727","matchMethod":"none","newText":"IIT Delhi's GenAI guidelines call for full disclosure of any work or content generated with the assistance of GenAI tools, including noting AI-created images, tables, data visualizations, or significant text sections.","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]},{"id":"claim:claim-iitd-genai-02-20260727","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-iitd-genai-02-20260727","matchMethod":"none","newText":"The guidelines state that authors remain fully responsible for verifying the accuracy of AI-assisted work, rigorously fact-checking it and proactively confirming it is free from plagiarism.","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]},{"id":"claim:claim-iitd-genai-03-20260727","category":"tracker_addition","theme":"privacy","claimId":"claim-iitd-genai-03-20260727","matchMethod":"none","newText":"The guidelines direct all users to exercise caution when entering data into GenAI tools and to screen out sensitive or private details before use.","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]},{"id":"claim:claim-iitd-genai-04-20260727","category":"tracker_addition","theme":"teaching","claimId":"claim-iitd-genai-04-20260727","matchMethod":"none","newText":"IIT Delhi's committee holds that outright restriction of GenAI tools is neither enforceable nor desirable and recommends that each course instructor develop their own plagiarism policy governing AI use.","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]},{"id":"claim:claim-iitd-genai-05-20260727","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-iitd-genai-05-20260727","matchMethod":"none","newText":"Course-level plagiarism policies are expected to set differentiated consequences for AI misuse while rewarding honest, responsible engagement with AI tools.","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]},{"id":"claim:claim-iitd-genai-06-20260727","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-iitd-genai-06-20260727","matchMethod":"none","newText":"The committee recommends that IIT Delhi acquire institute-wide licenses for paid GenAI tools such as ChatGPT and GitHub Copilot to ensure equitable access.","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]},{"id":"claim:claim-iitd-genai-07-20260727","category":"tracker_addition","theme":"teaching","claimId":"claim-iitd-genai-07-20260727","matchMethod":"none","newText":"Academic Units are advised to reevaluate assessment methods, prioritizing approaches that AI tools cannot easily replicate.","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]},{"id":"source_added:https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://academics.iitd.ac.in/wp-content/uploads/2025/09/IITD-AI-Guidelines.pdf"]}],"counts":{"affected":7,"held":0,"added":7,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"552597eb56b46a586a7b29795ffdeb4142beb3c20806f881b816290fdd5952aa"}]}],"coverage":{"recordedFrom":"2026-07-27T05:20:00.000Z","gaps":[]}}