{"schemaVersion":"uapt-school-change-events-v2","revision":"qs46-50-v6-r1-20261023","slug":"xi-an-jiaotong-liverpool-university","basisSha256":"c96faf43f849ffa68ba03ef83e7138f23c153dbd5ed26c33bd47a6689a154b6f","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"xi-an-jiaotong-liverpool-university:public-release-20260612-001","slug":"xi-an-jiaotong-liverpool-university","revision":"public-release-20260612-001","previousRevision":"public-release-20260526-003","publishedAt":"2026-05-31T20:46:00.000Z","url":"/changes/public-release-20260612-001/xi-an-jiaotong-liverpool-university","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:xjtlu-claim-ai-policy-framework-objective","category":"tracker_addition","theme":"source_status","claimId":"xjtlu-claim-ai-policy-framework-objective","matchMethod":"none","newText":"XJTLU's 2025-2028 Education + AI Strategic Framework sets an objective to develop and implement a robust AI policy framework for ethical AI development, deployment, and use; the source is a strategic framework rather than a standalone binding student AI policy.","sourceUrls":["https://www.xjtlu.edu.cn/wp-content/uploads/2025/03/XJTLU-Education-AI-Strategic-Framework.pdf"]},{"id":"claim:xjtlu-claim-library-verify-genai-output","category":"tracker_addition","theme":"academic_integrity","claimId":"xjtlu-claim-library-verify-genai-output","matchMethod":"none","newText":"XJTLU Library's GenAI citation guide advises that information provided by generative AI should always be checked and verified because it can be false, biased, out of date, or hallucinated.","sourceUrls":["https://libguides.lib.xjtlu.edu.cn/Generative-AI/Citing-AIGC"]},{"id":"claim:xjtlu-claim-student-ai-use-policy-review","category":"tracker_addition","theme":"academic_integrity","claimId":"xjtlu-claim-student-ai-use-policy-review","matchMethod":"none","newText":"XJTLU's strategic framework says the university will continuously review and update policy and procedures as necessary for appropriate and inappropriate AI use by students.","sourceUrls":["https://www.xjtlu.edu.cn/wp-content/uploads/2025/03/XJTLU-Education-AI-Strategic-Framework.pdf"]},{"id":"claim:xjtlu-claim-teaching-chatbot-risks","category":"tracker_addition","theme":"teaching","claimId":"xjtlu-claim-teaching-chatbot-risks","matchMethod":"none","newText":"XJTLU's official teaching resource on AI chatbots identifies reliability and accuracy problems, data privacy, potential bias, and academic integrity risk as challenges that need to be addressed.","sourceUrls":["https://www.xjtlu.edu.cn/en/study/departments/using-ai-for-teaching/using-ai-chatbot-for-teaching-version2-2"]},{"id":"claim:xjtlu-claim-xipu-ai-ethical-use-guidelines","category":"tracker_addition","theme":"privacy","claimId":"xjtlu-claim-xipu-ai-ethical-use-guidelines","matchMethod":"none","newText":"For the XIPU AI platform, XJTLU's strategic framework sets an objective to establish ethical-use guidelines focusing on data privacy, bias mitigation, and transparency.","sourceUrls":["https://www.xjtlu.edu.cn/wp-content/uploads/2025/03/XJTLU-Education-AI-Strategic-Framework.pdf"]},{"id":"source_added:https://libguides.lib.xjtlu.edu.cn/Generative-AI/Citing-AIGC","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://libguides.lib.xjtlu.edu.cn/Generative-AI/Citing-AIGC"]},{"id":"source_added:https://www.xjtlu.edu.cn/en/study/departments/using-ai-for-teaching/using-ai-chatbot-for-teaching-version2-2","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.xjtlu.edu.cn/en/study/departments/using-ai-for-teaching/using-ai-chatbot-for-teaching-version2-2"]},{"id":"source_added:https://www.xjtlu.edu.cn/wp-content/uploads/2025/03/XJTLU-Education-AI-Strategic-Framework.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.xjtlu.edu.cn/wp-content/uploads/2025/03/XJTLU-Education-AI-Strategic-Framework.pdf"]}],"counts":{"affected":5,"held":0,"added":5,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"71b9e68381cfacccafe03949b5d8e0a009e88369bad7bd1dff10ab96b77785c4"}]}],"coverage":{"recordedFrom":"2026-05-31T20:46:00.000Z","gaps":[]}}