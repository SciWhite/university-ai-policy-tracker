{"schemaVersion":"uapt-school-change-events-v2","revision":"qs91-100-v6-presentation-r1-20261026","slug":"universite-lumiere-lyon-2","basisSha256":"a1d6e1ee8ec909d02e8e5685f6b06229a71c4d2b4e951ab04ed5ce435bdb2565","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"universite-lumiere-lyon-2:public-release-20260526-003","slug":"universite-lumiere-lyon-2","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-26T05:09:59.000Z","url":"/changes/public-release-20260526-003/universite-lumiere-lyon-2","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-lyon2-ai-assistance-exam-conditions","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-lyon2-ai-assistance-exam-conditions","matchMethod":"none","newText":"Lyon 2 SPS guidance says AI should not do assessed work in place of the student; AI assistance may be possible only when it respects university ethics and the specific instructions for the exam or assignment.","sourceUrls":["https://moodle-ouvert.univ-lyon2.fr/pluginfile.php/282662/mod_resource/content/11/Repe%CC%80res-IA_ULL2_2024-06_V3.pdf"]},{"id":"claim:claim-lyon2-ai-citation-disclosure-guidance","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-lyon2-ai-citation-disclosure-guidance","matchMethod":"none","newText":"Lyon 2 SPS guidance tells students to follow instructor instructions for citing AI-generated text; if no instruction is provided, it suggests noting the software publisher, software name, and initial prompt.","sourceUrls":["https://moodle-ouvert.univ-lyon2.fr/pluginfile.php/282662/mod_resource/content/11/Repe%CC%80res-IA_ULL2_2024-06_V3.pdf"]},{"id":"claim:claim-lyon2-ai-data-privacy-caveat","category":"tracker_addition","theme":"privacy","claimId":"claim-lyon2-ai-data-privacy-caveat","matchMethod":"none","newText":"Lyon 2 SPS guidance cautions that public generative-AI tools often give little regard to copyright and personal data, including data found online and data uploaded by users.","sourceUrls":["https://moodle-ouvert.univ-lyon2.fr/pluginfile.php/282662/mod_resource/content/11/Repe%CC%80res-IA_ULL2_2024-06_V3.pdf"]},{"id":"claim:claim-lyon2-ai-detection-limits","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-lyon2-ai-detection-limits","matchMethod":"none","newText":"Lyon 2 SPS guidance warns that generative-AI text detectors have limited reliability, provide only a degree of presumption, and cannot identify a source like similarity detectors, making their results unusable in appeals.","sourceUrls":["https://moodle-ouvert.univ-lyon2.fr/pluginfile.php/282662/mod_resource/content/11/Repe%CC%80res-IA_ULL2_2024-06_V3.pdf"]},{"id":"claim:claim-lyon2-reglement-ai-disclosure","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-lyon2-reglement-ai-disclosure","matchMethod":"none","newText":"Université Lumière Lyon 2's règlement intérieur prohibits using an artificial-intelligence tool in university work without explicit mention, and prohibits presenting AI-generated content as personal human work, under disciplinary proceedings.","sourceUrls":["https://www.univ-lyon2.fr/medias/fichier/reglement-interieur20241016_1729083058500-pdf"]},{"id":"claim:claim-lyon2-teaching-clear-ai-rules","category":"tracker_addition","theme":"teaching","claimId":"claim-lyon2-teaching-clear-ai-rules","matchMethod":"none","newText":"Lyon 2 SPS guidance recommends that instructors explicitly state expected conditions for student work, including obligations, permissions, recommendations, prohibitions, whether generative AI may be used, and how any use should be signaled.","sourceUrls":["https://moodle-ouvert.univ-lyon2.fr/pluginfile.php/282662/mod_resource/content/11/Repe%CC%80res-IA_ULL2_2024-06_V3.pdf"]},{"id":"source_added:https://moodle-ouvert.univ-lyon2.fr/course/view.php?id=606","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://moodle-ouvert.univ-lyon2.fr/course/view.php?id=606"]},{"id":"source_added:https://moodle-ouvert.univ-lyon2.fr/pluginfile.php/282662/mod_resource/content/11/Repe%CC%80res-IA_ULL2_2024-06_V3.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://moodle-ouvert.univ-lyon2.fr/pluginfile.php/282662/mod_resource/content/11/Repe%CC%80res-IA_ULL2_2024-06_V3.pdf"]},{"id":"source_added:https://www.univ-lyon2.fr/medias/fichier/reglement-interieur20241016_1729083058500-pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.univ-lyon2.fr/medias/fichier/reglement-interieur20241016_1729083058500-pdf"]}],"counts":{"affected":6,"held":0,"added":6,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"64a18ef6bf478accbe425bb35db049123c00d33d4ea17f9b6f0d781ab100ac2b"}]}],"coverage":{"recordedFrom":"2026-05-26T05:09:59.000Z","gaps":[]}}
