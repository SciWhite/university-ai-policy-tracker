{"schemaVersion":"uapt-school-change-events-v2","revision":"qs91-100-v6-presentation-r1-20261026","slug":"university-of-east-london","basisSha256":"a1d6e1ee8ec909d02e8e5685f6b06229a71c4d2b4e951ab04ed5ce435bdb2565","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-east-london:public-release-20260526-003","slug":"university-of-east-london","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T14:55:00.000Z","url":"/changes/public-release-20260526-003/university-of-east-london","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:uel-claim-ai-security-oversight","category":"tracker_addition","theme":"security_review","claimId":"uel-claim-ai-security-oversight","matchMethod":"none","newText":"UEL's GenAI usage policy says AI systems must prioritize user safety and ethical standards, provide clear documentation, and implement robust security protocols, while human checks should monitor impactful AI decisions.","sourceUrls":["https://www.uel.ac.uk/about/governance/general-policies/generative-artificial-intelligence-usage-policy"]},{"id":"claim:uel-claim-genai-academic-misconduct","category":"tracker_addition","theme":"academic_integrity","claimId":"uel-claim-genai-academic-misconduct","matchMethod":"none","newText":"UEL's academic misconduct rules define Generative AI misuse as using tools such as ChatGPT, Bing Chat, or DALL-E to gain an unfair advantage by producing content submitted as the student's own original work.","sourceUrls":["https://www.uel.ac.uk/about/governance/manual-general-regulations/academic-integrity-academic-misconduct"]},{"id":"claim:uel-claim-genai-policy-scope","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"uel-claim-genai-policy-scope","matchMethod":"none","newText":"The University of East London's Generative Artificial Intelligence Usage Policy applies to staff, students, third-party suppliers, partners, and affiliates who develop, deploy, or use GenAI technologies.","sourceUrls":["https://www.uel.ac.uk/about/governance/general-policies/generative-artificial-intelligence-usage-policy"]},{"id":"claim:uel-claim-responsible-genai-framework","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"uel-claim-responsible-genai-framework","matchMethod":"none","newText":"UEL's GenAI usage policy frames responsible use around transparency, ethical considerations, responsible data usage, and compliance with legal and regulatory requirements.","sourceUrls":["https://www.uel.ac.uk/about/governance/general-policies/generative-artificial-intelligence-usage-policy"]},{"id":"source_added:https://www.uel.ac.uk/about/governance/general-policies/generative-artificial-intelligence-usage-policy","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.uel.ac.uk/about/governance/general-policies/generative-artificial-intelligence-usage-policy"]},{"id":"source_added:https://www.uel.ac.uk/about/governance/manual-general-regulations/academic-integrity-academic-misconduct","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.uel.ac.uk/about/governance/manual-general-regulations/academic-integrity-academic-misconduct"]}],"counts":{"affected":4,"held":0,"added":4,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"0e61e97d00891bbadcb526d09f264eb1ba7e62dd9c596921ca7f7cbdd592d5f5"}]}],"coverage":{"recordedFrom":"2026-05-23T14:55:00.000Z","gaps":[]}}
