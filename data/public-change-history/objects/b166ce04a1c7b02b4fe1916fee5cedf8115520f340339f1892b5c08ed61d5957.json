{"schemaVersion":"uapt-school-change-events-v2","revision":"qs91-100-v6-presentation-r1-20261026","slug":"university-of-deusto","basisSha256":"a1d6e1ee8ec909d02e8e5685f6b06229a71c4d2b4e951ab04ed5ce435bdb2565","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-deusto:public-release-20260526-003","slug":"university-of-deusto","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T14:57:00.000Z","url":"/changes/public-release-20260526-003/university-of-deusto","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-deusto-ai-commission-strategy-good-practices","category":"tracker_addition","theme":"source_status","claimId":"claim-deusto-ai-commission-strategy-good-practices","matchMethod":"none","newText":"The University of Deusto has an institutional Artificial Intelligence Commission responsible for defining and coordinating the university's AI strategy, promoting training, establishing good practices, and supporting adoption by the university community.","sourceUrls":["https://www.deusto.es/es/inicio/somos-deusto/estrategia-academica/ia-deusto"]},{"id":"claim:claim-deusto-ai-course-rules-control-student-use","category":"tracker_addition","theme":"teaching","claimId":"claim-deusto-ai-course-rules-control-student-use","matchMethod":"none","newText":"For each Deusto course, students are directed to review the course programme and learning guide for AI-use rules; those rules must be followed, including where AI use is prohibited.","sourceUrls":["https://www.deusto.es/es/inicio/somos-deusto/estrategia-academica/ia-deusto"]},{"id":"claim:claim-deusto-ai-disclosure-risk-privacy-principles","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-deusto-ai-disclosure-risk-privacy-principles","matchMethod":"none","newText":"Deusto's AI principles state that faculty, students, researchers, and management staff must communicate their use of AI, understand and assume AI-use risks, and respect privacy, confidentiality, and data-protection criteria when using AI.","sourceUrls":["https://www.deusto.es/es/inicio/somos-deusto/estrategia-academica/ia-deusto"]},{"id":"claim:claim-deusto-ai-positioning-generated-text-not-literal","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-deusto-ai-positioning-generated-text-not-literal","matchMethod":"none","newText":"Deusto's March 2024 AI positioning document states that text or other AI-generated resources may not be used literally and must instead be reviewed, reworked, or completed.","sourceUrls":["https://www.deusto.es/document/deusto/es/posicionamiento-deusto-uso-ia.pdf"]},{"id":"claim:claim-deusto-library-no-generic-generative-ai-permission","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-deusto-library-no-generic-generative-ai-permission","matchMethod":"none","newText":"A Deusto Library citation guide states that, at the university, there is currently no generic prohibition or generic permission for using generative AI, and points users who use generative AI in research or academic work to citation information.","sourceUrls":["https://biblioguias.biblioteca.deusto.es/c.php?g=213251&p=5211766"]},{"id":"source_added:https://biblioguias.biblioteca.deusto.es/c.php?g=213251&p=5211766","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://biblioguias.biblioteca.deusto.es/c.php?g=213251&p=5211766"]},{"id":"source_added:https://www.deusto.es/document/deusto/es/posicionamiento-deusto-uso-ia.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.deusto.es/document/deusto/es/posicionamiento-deusto-uso-ia.pdf"]},{"id":"source_added:https://www.deusto.es/es/inicio/somos-deusto/estrategia-academica/ia-deusto","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.deusto.es/es/inicio/somos-deusto/estrategia-academica/ia-deusto"]}],"counts":{"affected":5,"held":0,"added":5,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"f38067929b433032757f74a29d2517c745a0ca698c0b130b3da8dd9779128f61"}]}],"coverage":{"recordedFrom":"2026-05-23T14:57:00.000Z","gaps":[]}}
