{"schemaVersion":"uapt-school-change-events-v2","revision":"qs91-100-v6-presentation-r1-20261026","slug":"west-virginia-university","basisSha256":"a1d6e1ee8ec909d02e8e5685f6b06229a71c4d2b4e951ab04ed5ce435bdb2565","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"west-virginia-university:public-release-20260612-001","slug":"west-virginia-university","revision":"public-release-20260612-001","previousRevision":"public-release-20260526-003","publishedAt":"2026-05-31T20:42:45.000Z","url":"/changes/public-release-20260612-001/west-virginia-university","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:cc-wvu-admin-ai-purchase-review","category":"tracker_addition","theme":"procurement","claimId":"cc-wvu-admin-ai-purchase-review","matchMethod":"none","newText":"WVU guidance directs users to use the IT Purchase Request process to ensure an AI tool is secure, including free software.","sourceUrls":["https://it.wvu.edu/defend-your-data/use-of-generative-ai-for-administrative-purposes-at-wvu"]},{"id":"claim:cc-wvu-admin-ai-sensitive-data","category":"tracker_addition","theme":"privacy","claimId":"cc-wvu-admin-ai-sensitive-data","matchMethod":"none","newText":"WVU guidance says PII, confidential information, or other sensitive data must not be entered into a generative AI tool unless explicitly approved through the IT Purchase Request process.","sourceUrls":["https://it.wvu.edu/defend-your-data/use-of-generative-ai-for-administrative-purposes-at-wvu"]},{"id":"claim:cc-wvu-admin-guidance-scope","category":"tracker_addition","theme":"other","claimId":"cc-wvu-admin-guidance-scope","matchMethod":"none","newText":"WVU has formal guidance for generative AI use in administrative activities that applies to WVU faculty, staff, and students when they engage in administrative activities.","sourceUrls":["https://it.wvu.edu/defend-your-data/use-of-generative-ai-for-administrative-purposes-at-wvu"]},{"id":"claim:cc-wvu-faculty-senate-ai-syllabus-default","category":"tracker_addition","theme":"teaching","claimId":"cc-wvu-faculty-senate-ai-syllabus-default","matchMethod":"none","newText":"WVU Faculty Senate’s Artificial Intelligence Syllabus Statement says AI tools that create and develop academic content are not allowed unless an instructor gives permission.","sourceUrls":["https://facultysenate.wvu.edu/resources/syllabus-policies-and-statements"]},{"id":"claim:cc-wvu-faculty-senate-optional-ai-statements","category":"tracker_addition","theme":"teaching","claimId":"cc-wvu-faculty-senate-optional-ai-statements","matchMethod":"none","newText":"WVU Faculty Senate identifies its syllabus statements as optional, and provides additional sample AI statements that can allow or disallow AI use with documentation expectations.","sourceUrls":["https://facultysenate.wvu.edu/resources/syllabus-policies-and-statements"]},{"id":"claim:cc-wvu-library-ai-citation-resources","category":"tracker_addition","theme":"other","claimId":"cc-wvu-library-ai-citation-resources","matchMethod":"none","newText":"WVU Libraries’ ChatGPT guide has a Citation Styles and Policy page that points users to MLA, APA, and Chicago resources for citing generative AI.","sourceUrls":["https://libguides.wvu.edu/c.php?g=1329263&p=9827862"]},{"id":"claim:cc-wvu-student-ai-instructor-permission","category":"tracker_addition","theme":"academic_integrity","claimId":"cc-wvu-student-ai-instructor-permission","matchMethod":"none","newText":"WVU Academic Integrity’s AI student FAQ says students can use AI tools for assignments only when instructors allow them, and students should ask the instructor if unsure.","sourceUrls":["https://academicintegrity.wvu.edu/files/d/6f4a1587-ff74-4a15-a2b6-19abcd20c4cb/ai-student-faq.pdf"]},{"id":"claim:cc-wvu-student-ai-unauthorized-use","category":"tracker_addition","theme":"academic_integrity","claimId":"cc-wvu-student-ai-unauthorized-use","matchMethod":"none","newText":"WVU Academic Integrity’s AI student FAQ states that the WVU Policy on Student Academic Integrity prohibits unauthorized use of technological resources such as generative AI.","sourceUrls":["https://academicintegrity.wvu.edu/files/d/6f4a1587-ff74-4a15-a2b6-19abcd20c4cb/ai-student-faq.pdf"]},{"id":"source_added:https://academicintegrity.wvu.edu/files/d/6f4a1587-ff74-4a15-a2b6-19abcd20c4cb/ai-student-faq.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://academicintegrity.wvu.edu/files/d/6f4a1587-ff74-4a15-a2b6-19abcd20c4cb/ai-student-faq.pdf"]},{"id":"source_added:https://facultysenate.wvu.edu/resources/syllabus-policies-and-statements","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://facultysenate.wvu.edu/resources/syllabus-policies-and-statements"]},{"id":"source_added:https://it.wvu.edu/defend-your-data/use-of-generative-ai-for-administrative-purposes-at-wvu","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://it.wvu.edu/defend-your-data/use-of-generative-ai-for-administrative-purposes-at-wvu"]},{"id":"source_added:https://libguides.wvu.edu/c.php?g=1329263&p=9827862","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://libguides.wvu.edu/c.php?g=1329263&p=9827862"]}],"counts":{"affected":8,"held":0,"added":8,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"fa95dd99291262a5f7984647e995377d672f4954caa8d8f1544068c1fef114fe"}]}],"coverage":{"recordedFrom":"2026-05-31T20:42:45.000Z","gaps":[]}}
