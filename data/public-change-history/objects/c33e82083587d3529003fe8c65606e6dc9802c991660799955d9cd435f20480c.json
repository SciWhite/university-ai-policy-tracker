{"schemaVersion":"uapt-school-change-events-v2","revision":"qs71-90-v6-completeness-r2-20261025","slug":"university-of-nevada-reno","basisSha256":"fc7362bea155368de66e06f9e4b0b27316d00188159ee747fdd876799c8aa259","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-nevada-reno:public-release-20260719-012","slug":"university-of-nevada-reno","revision":"public-release-20260719-012","previousRevision":"public-release-20260719-011","publishedAt":"2026-07-19T15:27:39.689Z","url":"/changes/public-release-20260719-012/university-of-nevada-reno","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:cl-university-of-nevada-reno-microsoft-copilot-1093","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"cl-university-of-nevada-reno-microsoft-copilot-1093","matchMethod":"none","newText":"Microsoft 365 Copilot Chat is listed for University of Nevada - Reno in an official university AI tools source. Derived availability: allowed. Derived endorsement type: institutionally licensed or procured.","sourceUrls":["https://www.unr.edu/ai/students/copilot-chat"]},{"id":"source_added:https://www.unr.edu/ai/students/copilot-chat","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unr.edu/ai/students/copilot-chat"]}],"counts":{"affected":1,"held":0,"added":1,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"4139a22128b48cabe30438825b3fa7cfb82caf46ad4a9aabbfeb4c478431bec4"}]},{"id":"university-of-nevada-reno:public-release-20260526-003","slug":"university-of-nevada-reno","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-24T14:35:00.000Z","url":"/changes/public-release-20260526-003/university-of-nevada-reno","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-unr-ai-data-protection","category":"tracker_addition","theme":"privacy","claimId":"claim-unr-ai-data-protection","matchMethod":"none","newText":"UNR strongly advises users not to share sensitive, confidential, or regulated data with AI tools, because tool data-sharing practices may compromise confidentiality.","sourceUrls":["https://www.unr.edu/oit/policies/artificial-intelligence-policy"]},{"id":"claim:claim-unr-ai-detection-not-sole-factor","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-unr-ai-detection-not-sole-factor","matchMethod":"none","newText":"UNR teaching guidance says AI detection tools are not fully reliable and should not be used as the sole determining factor for deciding whether an AI-related academic standards violation occurred.","sourceUrls":["https://www.unr.edu/ai/teaching-with-ai/academic-integrity"]},{"id":"claim:claim-unr-ai-policy-scope","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-unr-ai-policy-scope","matchMethod":"none","newText":"UNR's OIT AI usage policy applies to students, employees, contractors, and third parties using AI platforms on behalf of the University, and frames responsible AI use around information security, data privacy, copyright, and academic integrity.","sourceUrls":["https://www.unr.edu/oit/policies/artificial-intelligence-policy"]},{"id":"claim:claim-unr-ai-syllabus-transparency","category":"tracker_addition","theme":"teaching","claimId":"claim-unr-ai-syllabus-transparency","matchMethod":"none","newText":"UNR teaching guidance recommends that instructors include an AI statement in the syllabus and discuss with students what AI use is and is not allowed for classes and course assignments.","sourceUrls":["https://www.unr.edu/ai/teaching-with-ai/syllabus"]},{"id":"claim:claim-unr-ai-vendor-risk","category":"tracker_addition","theme":"security_review","claimId":"claim-unr-ai-vendor-risk","matchMethod":"none","newText":"UNR directs users to initiate an OIT Compliance vendor risk management assessment before integrating an AI tool into daily tasks.","sourceUrls":["https://www.unr.edu/ai/technology-usage"]},{"id":"claim:claim-unr-library-ai-citation","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-unr-library-ai-citation","matchMethod":"none","newText":"UNR Library's APA guide says AI-generated works must be cited when used as a quoted, paraphrased, or otherwise incorporated source, while process uses such as brainstorming or proofreading should be acknowledged rather than cited.","sourceUrls":["https://guides.library.unr.edu/apacitation/generativeai"]},{"id":"claim:claim-unr-unauthorized-ai-cheating","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-unr-unauthorized-ai-cheating","matchMethod":"none","newText":"UNR's Academic Standards policy defines cheating to include unauthorized use of generative AI content generators or generative AI tools.","sourceUrls":["https://www.unr.edu/administrative-manual/6000-6999-courses-curricula-and-organizational-change-process/6502-academic-standards"]},{"id":"source_added:https://guides.library.unr.edu/apacitation/generativeai","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://guides.library.unr.edu/apacitation/generativeai"]},{"id":"source_added:https://www.unr.edu/administrative-manual/6000-6999-courses-curricula-and-organizational-change-process/6502-academic-standards","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unr.edu/administrative-manual/6000-6999-courses-curricula-and-organizational-change-process/6502-academic-standards"]},{"id":"source_added:https://www.unr.edu/ai/teaching-with-ai/academic-integrity","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unr.edu/ai/teaching-with-ai/academic-integrity"]},{"id":"source_added:https://www.unr.edu/ai/teaching-with-ai/syllabus","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unr.edu/ai/teaching-with-ai/syllabus"]},{"id":"source_added:https://www.unr.edu/ai/technology-usage","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unr.edu/ai/technology-usage"]},{"id":"source_added:https://www.unr.edu/oit/policies/artificial-intelligence-policy","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unr.edu/oit/policies/artificial-intelligence-policy"]}],"counts":{"affected":7,"held":0,"added":7,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"3ec1b66f78f7e59bdf41c01165eb71185dbf69e0e170888d095a3c14ae1fe304"}]}],"coverage":{"recordedFrom":"2026-05-24T14:35:00.000Z","gaps":[]}}
