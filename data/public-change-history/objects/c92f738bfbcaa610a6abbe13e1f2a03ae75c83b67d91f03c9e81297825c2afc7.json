{"schemaVersion":"uapt-school-change-events-v2","revision":"qs71-90-v6-reviewed-r1-20261025","slug":"university-of-parma","basisSha256":"831ef681acccfa38466e5412c76abb89c77d7b90bf0151e5a6ac78ad4f696088","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-parma:public-release-20260526-003","slug":"university-of-parma","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-25T06:26:30.000Z","url":"/changes/public-release-20260526-003/university-of-parma","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-unipr-ai-academic-integrity-citation","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-unipr-ai-academic-integrity-citation","matchMethod":"none","newText":"For academic materials, the guidelines say use of generative AI must be explicitly declared with the tool, version, and purpose; not declaring AI use is described as a violation of academic integrity rules.","sourceUrls":["https://www.unipr.it/sites/default/files/2025-05/Linee%20guida%20per%20l%27utilizzo%20responsabile%20dell%E2%80%99intelligenza%20artificiale%20in%20ambito%20didattico%20e%20di%20ricerca_0.pdf"]},{"id":"claim:claim-unipr-ai-guidelines-approved-2025","category":"tracker_addition","theme":"source_status","claimId":"claim-unipr-ai-guidelines-approved-2025","matchMethod":"none","newText":"University of Parma has official 2025 guidelines for responsible use of generative AI in teaching and research, approved by the Academic Senate and Board of Directors.","sourceUrls":["https://www.unipr.it/sites/default/files/2025-05/Linee%20guida%20per%20l%27utilizzo%20responsabile%20dell%E2%80%99intelligenza%20artificiale%20in%20ambito%20didattico%20e%20di%20ricerca_0.pdf"]},{"id":"claim:claim-unipr-ai-human-oversight","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-unipr-ai-human-oversight","matchMethod":"none","newText":"The guidelines treat generative AI as support for teaching, learning, and research, not a replacement for human work; AI-generated content should be examined, approved, modified, and supervised by a human author.","sourceUrls":["https://www.unipr.it/sites/default/files/2025-05/Linee%20guida%20per%20l%27utilizzo%20responsabile%20dell%E2%80%99intelligenza%20artificiale%20in%20ambito%20didattico%20e%20di%20ricerca_0.pdf"]},{"id":"claim:claim-unipr-ai-non-appropriate-uses","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-unipr-ai-non-appropriate-uses","matchMethod":"none","newText":"The guidelines list non-appropriate or non-permitted academic uses of AI, including creating entire written content with AI, using unrevised AI-generated code, using AI-generated code in university exams, and using AI to evaluate exam or selection materials.","sourceUrls":["https://www.unipr.it/sites/default/files/2025-05/Linee%20guida%20per%20l%27utilizzo%20responsabile%20dell%E2%80%99intelligenza%20artificiale%20in%20ambito%20didattico%20e%20di%20ricerca_0.pdf"]},{"id":"claim:claim-unipr-ai-privacy-confidential-data","category":"tracker_addition","theme":"privacy","claimId":"claim-unipr-ai-privacy-confidential-data","matchMethod":"none","newText":"The guidelines tell teachers and students to use AI tools safely and appropriately, avoiding confidential information, unpublished research data, and third-party personal data unless confidentiality, consent, or another suitable legal basis is in place.","sourceUrls":["https://www.unipr.it/sites/default/files/2025-05/Linee%20guida%20per%20l%27utilizzo%20responsabile%20dell%E2%80%99intelligenza%20artificiale%20in%20ambito%20didattico%20e%20di%20ricerca_0.pdf"]},{"id":"source_added:https://www.unipr.it/documenti/linee-guida-lutilizzo-responsabile-dellintelligenza-artificiale-ambito-didattico-e-di","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unipr.it/documenti/linee-guida-lutilizzo-responsabile-dellintelligenza-artificiale-ambito-didattico-e-di"]},{"id":"source_added:https://www.unipr.it/en/artificial-intelligence-guidelines","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unipr.it/en/artificial-intelligence-guidelines"]},{"id":"source_added:https://www.unipr.it/sites/default/files/2025-05/Linee%20guida%20per%20l%27utilizzo%20responsabile%20dell%E2%80%99intelligenza%20artificiale%20in%20ambito%20didattico%20e%20di%20ricerca_0.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.unipr.it/sites/default/files/2025-05/Linee%20guida%20per%20l%27utilizzo%20responsabile%20dell%E2%80%99intelligenza%20artificiale%20in%20ambito%20didattico%20e%20di%20ricerca_0.pdf"]}],"counts":{"affected":5,"held":0,"added":5,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"281bbc62d217e1f2fa177d0378c2ff147f79dc43f80dd821def9610a9e189386"}]}],"coverage":{"recordedFrom":"2026-05-25T06:26:30.000Z","gaps":[]}}
