{"schemaVersion":"uapt-school-change-events-v2","revision":"qs51-70-v6-complete-r4-20261025","slug":"universiti-malaysia-sarawak-unimas","basisSha256":"6f6afd1f1534b12348bfbbfa9fd2118de1b10cb86f13fa099846cd1e66c69073","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"universiti-malaysia-sarawak-unimas:public-release-20260526-003","slug":"universiti-malaysia-sarawak-unimas","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T04:21:00Z","url":"/changes/public-release-20260526-003/universiti-malaysia-sarawak-unimas","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-unimas-fssh-ai-good-practice-2025","category":"tracker_addition","theme":"teaching","claimId":"claim-unimas-fssh-ai-good-practice-2025","matchMethod":"none","newText":"The UNIMAS Faculty of Social Sciences and Humanities 2025/2026 student handbook frames good AI practice as using AI as a support tool, checking AI responses against academic sources, using AI to sharpen critical thinking, and recognizing that AI responses may be inaccurate or unsuitable.","sourceUrls":["https://www.fssh.unimas.my/media/attachments/2025/11/10/buku-panduan-pelajar-fssk-2025-2026_v2-30.10.2025-2-compressed.pdf"]},{"id":"claim:claim-unimas-fssh-ai-integrity-2025","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-unimas-fssh-ai-integrity-2025","matchMethod":"none","newText":"The UNIMAS Faculty of Social Sciences and Humanities 2025/2026 student handbook says AI does not replace lecturers, lecture notes, or main academic references, and warns students not to copy directly from AI answers, submit AI answers as their own work without citation, or use AI to cheat in exams or assignments.","sourceUrls":["https://www.fssh.unimas.my/media/attachments/2025/11/10/buku-panduan-pelajar-fssk-2025-2026_v2-30.10.2025-2-compressed.pdf"]},{"id":"claim:claim-unimas-fssh-ai-purpose-2025","category":"trac