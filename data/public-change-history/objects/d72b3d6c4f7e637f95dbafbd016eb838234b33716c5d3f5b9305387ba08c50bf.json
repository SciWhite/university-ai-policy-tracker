{"schemaVersion":"uapt-school-change-events-v2","revision":"qs71-90-v6-reviewed-r1-20261025","slug":"university-of-anbar","basisSha256":"831ef681acccfa38466e5412c76abb89c77d7b90bf0151e5a6ac78ad4f696088","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-anbar:public-release-20260526-003","slug":"university-of-anbar","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T04:17:15.000Z","url":"/changes/public-release-20260526-003/university-of-anbar","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-anbar-ajas-ai-disclosure-reviewer-editor","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-anbar-ajas-ai-disclosure-reviewer-editor","matchMethod":"none","newText":"The Anbar Journal of Agricultural Sciences requires manuscript AI-use disclosure at submission and bars reviewers from using AI tools to generate review reports while stating that editors must not rely on AI for editorial decisions.","sourceUrls":["https://ajas.uoanbar.edu.iq/page_1595.html"]},{"id":"claim:claim-anbar-ajas-ai-prohibited-uses","category":"tracker_addition","theme":"research","claimId":"claim-anbar-ajas-ai-prohibited-uses","matchMethod":"none","newText":"The Anbar Journal of Agricultural Sciences prohibits AI use for generating scientific content without human verification, fabricating or manipulating data, obscuring authorship responsibility, or listing AI tools as co-authors.","sourceUrls":["https://ajas.uoanbar.edu.iq/page_1595.html"]},{"id":"claim:claim-anbar-aujll-ai-disclosure","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-anbar-aujll-ai-disclosure","matchMethod":"none","newText":"The University of Anbar Journal of Languages and Literature requires authors to explicitly disclose AI-tool use in the Acknowledgment or Methodology section, including the tool, version, and purpose.","sourceUrls":["https://aujll.uoanbar.edu.iq/index.php/aujll/PO"]},{"id":"claim:claim-anbar-aujll-ai-supportive-only","category":"tracker_addition","theme":"research","claimId":"claim-anbar-aujll-ai-supportive-only","matchMethod":"none","newText":"The University of Anbar Journal of Languages and Literature permits reliable AI tools only for supportive purposes such as proofreading, formatting, and scientifically verifiable linguistic or textual analysis.","sourceUrls":["https://aujll.uoanbar.edu.iq/index.php/aujll/PO"]},{"id":"source_added:https://ajas.uoanbar.edu.iq/page_1595.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://ajas.uoanbar.edu.iq/page_1595.html"]},{"id":"source_added:https://aujll.uoanbar.edu.iq/index.php/aujll/PO","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://aujll.uoanbar.edu.iq/index.php/aujll/PO"]}],"counts":{"affected":4,"held":0,"added":4,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"07f1d7ed090745e4faeb2335941d8035036f3ac1a9db48d6fb15abd963af86e1"}]}],"coverage":{"recordedFrom":"2026-05-23T04:17:15.000Z","gaps":[]}}
