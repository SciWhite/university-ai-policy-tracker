{"schemaVersion":"uapt-school-change-events-v2","revision":"qs91-100-v6-presentation-r1-20261026","slug":"universiti-tun-hussein-onn-malaysia-uthm","basisSha256":"a1d6e1ee8ec909d02e8e5685f6b06229a71c4d2b4e951ab04ed5ce435bdb2565","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"universiti-tun-hussein-onn-malaysia-uthm:public-release-20260526-003","slug":"universiti-tun-hussein-onn-malaysia-uthm","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T04:21:30.000Z","url":"/changes/public-release-20260526-003/universiti-tun-hussein-onn-malaysia-uthm","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-uthm-ai-generated-work-plagiarism","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uthm-ai-generated-work-plagiarism","matchMethod":"none","newText":"UTHM's plagiarism prevention regulations apply to students, former students, staff, former staff, and relevant current or former university community members, and define plagiarism to include submitting or publishing all or part of work generated by generative artificial intelligence as one's own work.","sourceUrls":["https://puu.uthm.edu.my/index.php/rujukan/akta-akta-perlembagaan-kaedah-perintah-peraturan-1/peraturan/85-plagiarisme-dwi-bahasa-with-cover-page"]},{"id":"claim:claim-uthm-assessment-design-kbg-misuse","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uthm-assessment-design-kbg-misuse","matchMethod":"none","newText":"UTHM's Digital Teaching and Learning Policy says assessment should be designed to be contextual, fair, transparent, and personalized while taking into account the risk of generative AI misuse in written assignments, and that continuous assessment involving presentations, question-and-answer, and viva voce should be prioritized to assess students' actual mastery.","sourceUrls":["https://maya.uthm.edu.my/images/sumber/Dasar%20PDP%20Digital%202025.pdf"]},{"id":"claim:claim-uthm-permits-kbg-in-pdp","category":"tracker_addition","theme":"teaching","claimId":"claim-uthm-permits-kbg-in-pdp","matchMethod":"none","newText":"UTHM's Digital Teaching and Learning Policy permits the use of generative artificial intelligence in teaching and learning processes, including learning content, activity implementation, and assessment, subject to suitability, assessment effectiveness, compliance with applicable guidelines, laws and regulations, and good principles, values, and ethics in the course field.","sourceUrls":["https://maya.uthm.edu.my/images/sumber/Dasar%20PDP%20Digital%202025.pdf"]},{"id":"source_added:https://maya.uthm.edu.my/images/sumber/Dasar%20PDP%20Digital%202025.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://maya.uthm.edu.my/images/sumber/Dasar%20PDP%20Digital%202025.pdf"]},{"id":"source_added:https://puu.uthm.edu.my/index.php/rujukan/akta-akta-perlembagaan-kaedah-perintah-peraturan-1/peraturan/85-plagiarisme-dwi-bahasa-with-cover-page","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://puu.uthm.edu.my/index.php/rujukan/akta-akta-perlembagaan-kaedah-perintah-peraturan-1/peraturan/85-plagiarisme-dwi-bahasa-with-cover-page"]}],"counts":{"affected":3,"held":0,"added":3,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"1552cd0d4a336751bbfefbee0bf6c275ccb74d92d72e4e241023d621c6bfe061"}]}],"coverage":{"recordedFrom":"2026-05-23T04:21:30.000Z","gaps":[]}}
