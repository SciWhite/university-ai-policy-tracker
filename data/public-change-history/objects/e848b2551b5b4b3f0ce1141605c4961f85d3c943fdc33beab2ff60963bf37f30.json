{"schemaVersion":"uapt-school-change-events-v2","revision":"qs51-70-v6-complete-r4-20261025","slug":"ashoka-university","basisSha256":"6f6afd1f1534b12348bfbbfa9fd2118de1b10cb86f13fa099846cd1e66c69073","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"ashoka-university:public-release-20260612-001","slug":"ashoka-university","revision":"public-release-20260612-001","previousRevision":"public-release-20260526-003","publishedAt":"2026-06-12T12:32:37.000Z","url":"/changes/public-release-20260612-001/ashoka-university","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-ashoka-academic-integrity-scope-original-work","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ashoka-academic-integrity-scope-original-work","matchMethod":"none","newText":"Ashoka University's Academic Integrity Policy applies to students doing coursework, research, thesis work, partner-university coursework, study-related internships or placements, and work with University Centers; it expects original work, source acknowledgement, independent assignment completion where applicable, and honesty during examinations.","sourceUrls":["https://my.ashoka.edu.in/SIS/UploadedFile/OrientationMaterial/Policies_1b312936-8ec3-4aae-bcc8-3bbf03b57d6e.pdf"]},{"id":"claim:claim-ashoka-aiashoka-source-status-research-not-policy","category":"tracker_addition","theme":"source_status","claimId":"claim-ashoka-aiashoka-source-status-research-not-policy","matchMethod":"none","newText":"Ashoka University's AI@Ashoka page is an official AI research-initiative page that describes interdisciplinary AI and machine-learning projects; it is not presented in the extracted text as a student AI-use policy, assessment rule, or approved-tools policy.","sourceUrls":["https://www.ashoka.edu.in/page/aiashoka/"]},{"id":"claim:claim-ashoka-course-fc0412-ai-ml-policy","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-ashoka-course-fc0412-ai-ml-policy","matchMethod":"none","newText":"In the Ashoka University course catalogue entry for Economy, Politics and Society (FC-0412-5), the course-level AI/ML policy discourages use of machine-learning tools such as ChatGPT in that class and asks students who use such a tool to declare its use and specify the extent of use.","sourceUrls":["https://www.ashoka.edu.in/course-catalogue/?co=SCH00000031&dept=APRG00000020&ls=FC-0412-5"]},{"id":"claim:claim-ashoka-public-academic-integrity-page-no-ai-specific-text","category":"tracker_addition","theme":"source_status","claimId":"claim-ashoka-public-academic-integrity-page-no-ai-specific-text","matchMethod":"none","newText":"Ashoka University's public Academic Integrity Policy page gives general academic-integrity and citation guidance, including mandatory academic-integrity workshop language, but the extracted public page text did not contain AI-specific, ChatGPT, or generative-AI rules.","sourceUrls":["https://www.ashoka.edu.in/academic-integrity-policy/"]},{"id":"source_added:https://my.ashoka.edu.in/SIS/UploadedFile/OrientationMaterial/Policies_1b312936-8ec3-4aae-bcc8-3bbf03b57d6e.pdf","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://my.ashoka.edu.in/SIS/UploadedFile/OrientationMaterial/Policies_1b312936-8ec3-4aae-bcc8-3bbf03b57d6e.pdf"]},{"id":"source_added:https://www.ashoka.edu.in/academic-integrity-policy/","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.ashoka.edu.in/academic-integrity-policy/"]},{"id":"source_added:https://www.ashoka.edu.in/course-catalogue/?co=SCH00000031&dept=APRG00000020&ls=FC-0412-5","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.ashoka.edu.in/course-catalogue/?co=SCH00000031&dept=APRG00000020&ls=FC-0412-5"]},{"id":"source_added:https://www.ashoka.edu.in/page/aiashoka/","category":"source_update","theme":"sources","matchMe