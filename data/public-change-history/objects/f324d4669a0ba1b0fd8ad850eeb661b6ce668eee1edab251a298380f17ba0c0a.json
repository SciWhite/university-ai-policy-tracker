{"schemaVersion":"uapt-school-change-events-v2","revision":"qs71-90-v6-reviewed-r1-20261025","slug":"university-of-hradec-kralove","basisSha256":"831ef681acccfa38466e5412c76abb89c77d7b90bf0151e5a6ac78ad4f696088","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"university-of-hradec-kralove:public-release-20260526-003","slug":"university-of-hradec-kralove","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T14:54:00.000Z","url":"/changes/public-release-20260526-003/university-of-hradec-kralove","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-uhk-ai-data-privacy","category":"tracker_addition","theme":"privacy","claimId":"claim-uhk-ai-data-privacy","matchMethod":"none","newText":"UHK tells students using AI tools to observe personal-data protection principles, avoid misuse of UHK or partner-owned information, and recommends not entering personal data or non-public information into external AI tools unless consent/legal basis and provider terms support it.","sourceUrls":["https://www.uhk.cz/file/edee/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty/ridici-akty/prorektori/smernice-a-pokyny/2026/pokyny-k-vyuzivani-umele-inteligence-studenty-pri-plneni-studijnich-povinnosti-na-uhk.pdf?v20260324141326"]},{"id":"claim:claim-uhk-ai-disclosure","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uhk-ai-disclosure","matchMethod":"none","newText":"For theses, projects, and other written study obligations at UHK, AI use must be disclosed as directed; where no method is set, students should state at least the purpose and scope of use, and for theses/projects also how AI output correctness was verified when relevant.","sourceUrls":["https://www.uhk.cz/file/edee/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty/ridici-akty/prorektori/smernice-a-pokyny/2026/pokyny-k-vyuzivani-umele-inteligence-studenty-pri-plneni-studijnich-povinnosti-na-uhk.pdf?v20260324141326"]},{"id":"claim:claim-uhk-current-ai-instruction","category":"tracker_addition","theme":"source_status","claimId":"claim-uhk-current-ai-instruction","matchMethod":"none","newText":"UHK's current prorector instruction 07/2026 on student use of AI for study obligations is listed as valid and effective from 1 April 2026 and replaces the earlier 01/2024 instruction.","sourceUrls":["https://www.uhk.cz/cs/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty-2/ridici-akty/pokyny-prorektoru/2026","https://www.uhk.cz/file/edee/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty/ridici-akty/prorektori/smernice-a-pokyny/2026/pokyny-k-vyuzivani-umele-inteligence-studenty-pri-plneni-studijnich-povinnosti-na-uhk.pdf?v20260324141326"]},{"id":"claim:claim-uhk-staff-edge-ai-access","category":"tracker_addition","theme":"ai_tool_treatment","claimId":"claim-uhk-staff-edge-ai-access","matchMethod":"none","newText":"UHK's IT guidance says Microsoft Edge AI chat functions are available to UHK employees with A3/A5 licenses, specifically employees at least half-time, when signed into Edge with a UHK account.","sourceUrls":["https://www.uhk.cz/cs/univerzita-hradec-kralove/uhk/celouniverzitni-pracoviste/oddeleni-informacnich-technologii/it-poradna/microsoft-365/umela-inteligence-v-ramci-ms-edge-pro-zamestnance"]},{"id":"claim:claim-uhk-student-ai-scope","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uhk-student-ai-scope","matchMethod":"none","newText":"For UHK study obligations, students may use AI tools only to the extent consistent with the obligation's objective and faculty or instructor rules; use must be transparent and the student remains responsible for content, correctness, citations, and originality.","sourceUrls":["https://www.uhk.cz/file/edee/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty/ridici-akty/prorektori/smernice-a-pokyny/2026/pokyny-k-vyuzivani-umele-inteligence-studenty-pri-plneni-studijnich-povinnosti-na-uhk.pdf?v20260324141326"]},{"id":"claim:claim-uhk-undisclosed-ai-misconduct","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-uhk-undisclosed-ai-misconduct","matchMethod":"none","newText":"UHK treats undisclosed AI use, AI use beyond what a student declared, or AI use contrary to the conditions for a work, project, or other study obligation as unethical conduct and potentially a disciplinary offense.","sourceUrls":["https://www.uhk.cz/file/edee/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty/ridici-akty/prorektori/smernice-a-pokyny/2026/pokyny-k-vyuzivani-umele-inteligence-studenty-pri-plneni-studijnich-povinnosti-na-uhk.pdf?v20260324141326"]},{"id":"source_added:https://www.uhk.cz/cs/univerzita-hradec-kralove/studium/vyuziti-umele-inteligence-ve-vyuce","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.uhk.cz/cs/univerzita-hradec-kralove/studium/vyuziti-umele-inteligence-ve-vyuce"]},{"id":"source_added:https://www.uhk.cz/cs/univerzita-hradec-kralove/uhk/celouniverzitni-pracoviste/oddeleni-informacnich-technologii/it-poradna/microsoft-365/umela-inteligence-v-ramci-ms-edge-pro-zamestnance","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.uhk.cz/cs/univerzita-hradec-kralove/uhk/celouniverzitni-pracoviste/oddeleni-informacnich-technologii/it-poradna/microsoft-365/umela-inteligence-v-ramci-ms-edge-pro-zamestnance"]},{"id":"source_added:https://www.uhk.cz/cs/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty-2/ridici-akty/pokyny-prorektoru/2026","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.uhk.cz/cs/univerzita-hradec-kralove/uhk/uredni-deska/vnitrni-predpisy-a-ridici-akty-2/ridici-akty/pokyny-prorektoru/2026"]},{"id":"sourc