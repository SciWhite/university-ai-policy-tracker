{"schemaVersion":"uapt-school-change-events-v2","revision":"qs51-70-v6-presentation-20261025","slug":"yokohama-national-university","basisSha256":"e7482ef3dcdc2bce8168bb39c6d75dead3281e15583e798ffa4cf2d203e3d6bf","rulesVersion":"tracker-events-1.2.0","currentClaimIds":[],"themeOrder":[],"events":[{"id":"yokohama-national-university:public-release-20260612-001","slug":"yokohama-national-university","revision":"public-release-20260612-001","previousRevision":"public-release-20260526-003","publishedAt":"2026-06-12T12:35:00.000Z","url":"/changes/public-release-20260612-001/yokohama-national-university","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:claim-ynu-admissions-generative-ai-warning","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ynu-admissions-generative-ai-warning","matchMethod":"none","newText":"For entrance examination documents, Yokohama National University asks examinees to prepare required documents with its generative AI reminders in mind and to submit work at their own responsibility so wrongdoing or post-admission academic mismatch is not suspected.","sourceUrls":["https://www.ynu.ac.jp/hus/nyushi/30283/detail.html"]},{"id":"claim:claim-ynu-ai-output-not-own-work","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ynu-ai-output-not-own-work","matchMethod":"none","newText":"Yokohama National University warns students not to use generative AI output unchanged as their own outcome, work, or creation, noting copyright and plagiarism risks.","sourceUrls":["https://www.ynu.ac.jp/hus/kyomu/30235/detail.html"]},{"id":"claim:claim-ynu-institutional-generative-ai-stance","category":"tracker_addition","theme":"source_status","claimId":"claim-ynu-institutional-generative-ai-stance","matchMethod":"none","newText":"Yokohama National University has a public institutional statement that frames generative AI as a technology with possibilities, limits, and risks to be considered across university members; this statement points students to a separate precautions page rather than presenting a standalone formal AI policy.","sourceUrls":["https://www.ynu.ac.jp/hus/kyomu/30234/detail.html"]},{"id":"claim:claim-ynu-no-personal-confidential-ai-input","category":"tracker_addition","theme":"privacy","claimId":"claim-ynu-no-personal-confidential-ai-input","matchMethod":"none","newText":"Yokohama National University warns students not to input personal information or confidential off-campus/internal information into generative AI because entered information may be used for AI learning or leak unintentionally.","sourceUrls":["https://www.ynu.ac.jp/hus/kyomu/30235/detail.html"]},{"id":"claim:claim-ynu-student-instructor-scope","category":"tracker_addition","theme":"academic_integrity","claimId":"claim-ynu-student-instructor-scope","matchMethod":"none","newText":"Yokohama National University tells students to pay sufficient attention to its generative AI precautions and, for course assignments, reports, experiments, and research papers, to strictly follow the scope of use instructed by the responsible or supervising instructor.","sourceUrls":["https://www.ynu.ac.jp/hus/kyomu/30235/detail.html"]},{"id":"source_added:https://www.ynu.ac.jp/hus/kyomu/30234/detail.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.ynu.ac.jp/hus/kyomu/30234/detail.html"]},{"id":"source_added:https://www.ynu.ac.jp/hus/kyomu/30235/detail.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.ynu.ac.jp/hus/kyomu/30235/detail.html"]},{"id":"source_added:https://www.ynu.ac.jp/hus/nyushi/30283/detail.html","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://www.ynu.ac.jp/hus/nyushi/30283/detail.html"]},{"id":"source_added:https://www.ynu.ac.jp/hus/nyushi/30294/detail.html","category":"source_update","theme":"sources","matchMethod":"source_cla