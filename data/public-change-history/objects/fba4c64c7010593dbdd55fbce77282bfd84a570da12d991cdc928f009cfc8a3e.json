tionally licensed or procured.","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3024/Zoom-AI-Companion"]},{"id":"source_added:https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3024/Zoom-AI-Companion","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3024/Zoom-AI-Companion"]},{"id":"source_added:https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3610/How-to-access-Microsoft-Copilot","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3610/How-to-access-Microsoft-Copilot"]},{"id":"source_added:https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3998/How-to-sign-in-to-Anthropic-Claude-AI","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3998/How-to-sign-in-to-Anthropic-Claude-AI"]}],"counts":{"affected":3,"held":0,"added":3,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"a17ffc7de57f7282c57174dd97d84eb40159650d58a289f191a3c4b300e5ce80"}]},{"id":"university-of-idaho:public-release-20260526-003","slug":"university-of-idaho","revision":"public-release-20260526-003","previousRevision":"public-release-20260526-001","publishedAt":"2026-05-23T14:48:54.000Z","url":"/changes/public-release-20260526-003/university-of-idaho","rulesVersion":"tracker-events-1.2.0","items":[{"id":"claim:uidaho-claim-agentic-ai","category":"tracker_addition","theme":"security_review","claimId":"uidaho-claim-agentic-ai","matchMethod":"none","newText":"University of Idaho OIT guidance says agentic AI tools should not receive credentials to university systems, should not be installed on systems with moderate- or high-risk data access, and should be tested in a sandboxed workflow.","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3464/Guidance-for-Artificial-Intelligence"]},{"id":"claim:uidaho-claim-ai-data-classification","category":"tracker_addition","theme":"privacy","claimId":"uidaho-claim-ai-data-classification","matchMethod":"none","newText":"University of Idaho OIT guidance says data uploaded to or downloaded from AI, including prompts, is subject to APM 30.11 data classification, and that listed AI services are approved only for the indicated data classifications.","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3464/Guidance-for-Artificial-Intelligence"]},{"id":"claim:uidaho-claim-employee-public-ai-data","category":"tracker_addition","theme":"privacy","claimId":"uidaho-claim-employee-public-ai-data","matchMethod":"none","newText":"University of Idaho's OIT and AI Execution Group memo tells university employees not to put identifiable student, employee, or regulated data into public AI models like ChatGPT and to remain vigilant about FERPA, HIPAA, GLBA, and other compliance requirements when using AI.","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/ArticleDet?ID=2823"]},{"id":"claim:uidaho-claim-faculty-ai-syllabi","category":"tracker_addition","theme":"teaching","claimId":"uidaho-claim-faculty-ai-syllabi","matchMethod":"none","newText":"University of Idaho's OIT and AI Execution Group memo advises faculty to provide clear guidance on AI use in their syllabi in Canvas.","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/ArticleDet?ID=2823"]},{"id":"claim:uidaho-claim-syllabus-options","category":"tracker_addition","theme":"teaching","claimId":"uidaho-claim-syllabus-options","matchMethod":"none","newText":"University of Idaho Center for Teaching and Learning syllabus language presents three course-level AI options: prohibiting AI use, allowing AI only with prior instructor permission, or allowing AI with documentation and citation.","sourceUrls":["https://support.uidaho.edu/TDClient/94/Portal/KB/Article/4048/Syllabus-Language-for-AI"]},{"id":"claim:uidaho-claim-unapproved-ai-services","category":"tracker_addition","theme":"security_review","claimId":"uidaho-claim-unapproved-ai-services","matchMethod":"none","newText":"University of Idaho OIT guidance allows unapproved, non-banned AI providers only when usage does not violate terms, copyright, or license requirements, uses low-risk data not specific to the university, and includes adequate review of terms of service and AI output.","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3464/Guidance-for-Artificial-Intelligence"]},{"id":"source_added:https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3464/Guidance-for-Artificial-Intelligence","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/Article/3464/Guidance-for-Artificial-Intelligence"]},{"id":"source_added:https://support.uidaho.edu/TDClient/40/Portal/KB/ArticleDet?ID=2823","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://support.uidaho.edu/TDClient/40/Portal/KB/ArticleDet?ID=2823"]},{"id":"source_added:https://support.uidaho.edu/TDClient/94/Portal/KB/Article/4048/Syllabus-Language-for-AI","category":"source_update","theme":"sources","matchMethod":"source_claim_type","sourceUrls":["https://support.uidaho.edu/TDClient/94/Portal/KB/Article/4048/Syllabus-Language-for-AI"]}],"counts":{"affected":6,"held":0,"added":6,"modified":0},"gaps":[],"provenance":[{"kind":"legacy","sha256":"b1fc98f8040b57c61e6208fc5af405c7349ebcefd39850b03c2a7b1edf53c94d"}]}],"coverage":{"recordedFrom":"2026-05-23T14:48:54.000Z","gaps":[]}}