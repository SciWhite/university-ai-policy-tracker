{
  "name": "university-ai-policy-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Public, SEO-first university AI policy change intelligence tracker.",
  "license": "Apache-2.0",
  "homepage": "https://eduaipolicy.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/SciWhite/university-ai-policy-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/SciWhite/university-ai-policy-tracker/issues"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "validate:v6-shards": "tsx scripts/validate-v6-shards.ts",
    "v6:shards": "tsx scripts/export-v6-shards.ts",
    "dev": "pnpm --parallel --filter @uapt/web --filter @uapt/api dev",
    "dev:web": "pnpm --filter @uapt/web dev",
    "dev:api": "pnpm --filter @uapt/api dev",
    "dev:worker": "pnpm --filter @uapt/worker dev",
    "build": "node scripts/program-build.mjs build --local --sha HEAD",
    "lint": "pnpm -r lint",
    "check": "pnpm db:generate && pnpm validate:i18n && pnpm validate:entity-aliases && pnpm validate:public-contract && pnpm validate:tool-records && pnpm validate:analysis-contract && pnpm validate:policy-snapshot && pnpm audit:policy-analysis && pnpm smoke:analysis-pages && pnpm smoke:entity-search && pnpm smoke:source-diffs && pnpm validate:openclaw-artifacts && pnpm validate:dataset-release && pnpm validate:v6-shards && pnpm validate:v6-release && pnpm validate:v6-source-metadata && pnpm audit:public-data && pnpm typecheck && pnpm lint",
    "smoke:universities-index": "tsx scripts/smoke-universities-index.ts",
    "smoke:reference-pages": "tsx scripts/smoke-reference-pages.ts",
    "smoke:pilot-pages": "tsx --tsconfig apps/web/tsconfig.json scripts/smoke-pilot-pages-http.ts",
    "smoke:i18n-http": "tsx scripts/smoke-i18n-http.ts",
    "typecheck": "pnpm -r typecheck",
    "audit:l0-consistency": "tsx scripts/audit-l0-dataset-consistency.ts",
    "audit:l1-live-fetch": "tsx scripts/audit-l1-live-fetch.ts",
    "audit:l1-browser-escalation": "tsx scripts/audit-l1-browser-escalation.ts",
    "audit:l2-snippet-anchors": "tsx scripts/audit-l2-snippet-anchors.ts",
    "audit:public-data": "tsx scripts/audit-public-data.ts",
    "audit:policy-analysis": "tsx scripts/audit-policy-analysis.ts",
    "smoke:analysis-pages": "tsx scripts/smoke-analysis-pages.ts",
    "smoke:entity-search": "tsx scripts/smoke-entity-search.ts",
    "smoke:source-diffs": "tsx scripts/smoke-source-diff-candidates.ts",
    "smoke:private-analytics": "tsx --tsconfig apps/web/tsconfig.json scripts/smoke-private-analytics-dashboard.ts",
    "build:review-cache": "tsx scripts/build-review-cache.ts",
    "readme:update-status": "tsx scripts/update-readme-status.ts",
    "knowledge:update": "tsx scripts/build-knowledge-snapshots.ts",
    "maintenance:scan": "tsx scripts/maintenance-http-first-scan.ts",
    "maintenance:build-review-queue": "tsx scripts/build-maintenance-review-queue.ts",
    "snapshots:baseline": "tsx scripts/build-private-source-snapshots.ts",
    "snapshots:repin-release": "tsx --tsconfig apps/web/tsconfig.json scripts/repin-policy-snapshots-release.ts",
    "source-diffs:build": "tsx scripts/build-source-diff-candidates.ts",
    "source-health:agent-verify": "tsx scripts/source-health-agent-verify.ts",
    "maintenance:start-light-review": "tsx scripts/start-lightweight-maintenance-review.ts",
    "maintenance:collect-review-results": "tsx scripts/collect-maintenance-review-results.ts",
    "maintenance:prepare-candidate": "tsx scripts/prepare-maintenance-release-candidate.ts",
    "maintenance:promote-candidate": "tsx scripts/promote-maintenance-release-candidate.ts",
    "validate:analysis-contract": "tsx scripts/validate-analysis-contract.ts",
    "validate:policy-snapshot": "tsx scripts/validate-policy-snapshot.ts",
    "test:policy-snapshot": "tsx --test tests/policy-snapshot.test.ts",
    "test:policy-snapshot-review": "tsx --test tests/policy-snapshot-independent-review.test.ts",
    "test:index-recovery-pilot": "tsx --tsconfig apps/web/tsconfig.json --test tests/index-recovery-pilot.test.ts",
    "test:visual-assets": "tsx --test tests/visual-assets.test.ts",
    "test:indexnow": "tsx --tsconfig apps/web/tsconfig.json --test tests/indexnow.test.ts",
    "indexnow:dry-run": "tsx --tsconfig apps/web/tsconfig.json scripts/submit-indexnow.ts --latest --dry-run",
    "indexnow:latest": "tsx --tsconfig apps/web/tsconfig.json scripts/submit-indexnow.ts --latest",
    "indexnow:all": "tsx --tsconfig apps/web/tsconfig.json scripts/submit-indexnow.ts --all",
    "program:build": "node scripts/program-build.mjs build",
    "program:package": "node scripts/program-build.mjs package",
    "test:program-build": "node --test tests/program-build.test.mjs tests/mcp-bundle.test.mjs tests/release-helper-bundle.test.mjs && python3 -m unittest tests/test_program_artifact_install.py",
    "test:program-release": "python3 -m unittest tests/test_program_release.py tests/test_release_lifecycle.py tests/test_web_watchdog.py tests/test_content_warmup.py tests/test_content_release_host.py",
    "smoke:policy-snapshot": "tsx scripts/smoke-policy-snapshot.ts",
    "validate:i18n": "NEXT_PUBLIC_MULTILINGUAL_PHASE_TWO=1 tsx scripts/validate-i18n.ts",
    "validate:entity-aliases": "tsx scripts/validate-entity-aliases.ts",
    "validate:tool-records": "tsx scripts/validate-tool-records.ts",
    "validate:public-contract": "tsx scripts/validate-public-contract.ts",
    "validate:openclaw-artifacts": "tsx scripts/validate-openclaw-artifacts.ts",
    "validate:dataset-release": "tsx scripts/validate-dataset-release.ts",
    "db:generate": "pnpm --filter @uapt/db generate",
    "db:migrate": "pnpm --filter @uapt/db migrate",
    "db:seed": "pnpm --filter @uapt/db seed",
    "ingest:sample": "tsx scripts/local-ingest-sample.ts",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "mcp:export": "tsx --tsconfig apps/web/tsconfig.json scripts/export-mcp-catalog.ts",
    "mcp:start": "pnpm --filter @uapt/mcp start",
    "test:mcp": "pnpm --filter @uapt/mcp test",
    "v6:pack": "tsx --tsconfig apps/web/tsconfig.json scripts/pack-v6-release.ts",
    "validate:v6-release": "tsc --noEmit -p scripts/tsconfig.v6.json && tsx --tsconfig apps/web/tsconfig.json scripts/validate-v6-release.ts",
    "validate:v6-source-metadata": "tsx --tsconfig apps/web/tsconfig.json scripts/content-release/v6-source-metadata-coverage.ts",
    "test:v6-source-metadata": "python3 -m unittest tests/test_v6_source_metadata.py",
    "validate:mcp-export": "tsc --noEmit -p scripts/tsconfig.mcp-export.json && tsx --tsconfig apps/web/tsconfig.json scripts/validate-mcp-export.ts",
    "test:mcp-acceptance": "pnpm mcp:export && pnpm validate:mcp-export && pnpm test:mcp",
    "test:v6-reading-preview": "tsx --tsconfig apps/web/tsconfig.json --test tests/policy-v6-reading-preview.test.tsx",
    "content:build": "tsx --tsconfig apps/web/tsconfig.json scripts/content-release/build.ts",
    "content:validate": "tsx --tsconfig apps/web/tsconfig.json scripts/content-release/validate.ts",
    "content:switch": "tsx --tsconfig apps/web/tsconfig.json scripts/content-release/switch.ts",
    "content:correct": "tsx --tsconfig apps/web/tsconfig.json scripts/content-release/correct.ts",
    "v6:status": "python3 scripts/v6-pipeline/status.py",
    "v6:discover": "${UAPT_CRAWL4AI_PYTHON:-python3} scripts/v6-pipeline/discover.py",
    "v6:firecrawl": "python3 scripts/v6-pipeline/firecrawl_discover.py",
    "v6:firecrawl-sources": "python3 scripts/v6-pipeline/firecrawl_sources.py",
    "v6:chatgpt-sources": "python3 scripts/v6-pipeline/chatgpt_sources.py",
    "v6:select": "python3 scripts/v6-pipeline/select_sources.py",
    "v6:capture": "python3 scripts/v6-pipeline/capture.py",
    "v6:render-capture": "${UAPT_CRAWL4AI_PYTHON:-python3} scripts/v6-pipeline/render_capture.py",
    "v6:gate": "python3 scripts/v6-pipeline/gates.py",
    "v6:build-view": "python3 scripts/v6-pipeline/build_view.py",
    "v6:finalize": "tsx --tsconfig apps/web/tsconfig.json scripts/v6-pipeline/finalize.ts",
    "v6:packets": "tsx --tsconfig apps/web/tsconfig.json scripts/v6-pipeline/packets.ts",
    "v6:chatgpt-brief": "python3 scripts/v6-pipeline/chatgpt_brief.py",
    "v6:receipts": "python3 scripts/v6-pipeline/receipts.py",
    "v6:check-meta": "tsx --tsconfig apps/web/tsconfig.json scripts/v6-pipeline/check-meta.ts",
    "v6:assemble": "tsx --tsconfig apps/web/tsconfig.json scripts/v6-pipeline/assemble.ts",
    "v6:readback": "python3 scripts/v6-pipeline/readback.py",
    "v6:sync-basis": "tsx --tsconfig apps/web/tsconfig.json scripts/v6-pipeline/sync-basis.ts",
    "v6:event": "python3 scripts/v6-pipeline/make_event.py",
    "v6:zh-gate": "tsx --tsconfig apps/web/tsconfig.json scripts/v6-pipeline/locale-gate.ts",
    "test:v6-pipeline": "tsc --noEmit -p scripts/tsconfig.v6-pipeline.json && python3 -m unittest tests/test_v6_pipeline.py && tsx --tsconfig apps/web/tsconfig.json --test tests/v6-pipeline-locale.test.ts",
    "content:bundle": "tsx --tsconfig apps/web/tsconfig.json scripts/content-release/bundle.ts",
    "content:host-release": "python3 scripts/release/content-release.py",
    "content:sync-proof": "python3 scripts/content-release/sync-proof.py",
    "test:content-release": "tsc --noEmit -p scripts/tsconfig.content-release.json && tsx --tsconfig apps/web/tsconfig.json --test tests/content-release.test.ts tests/content-correct.test.ts tests/reading-record-delta.test.ts tests/content-bundle.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.27.7",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
